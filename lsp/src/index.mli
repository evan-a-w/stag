open! Import

(** What is at each position of the files of a checked program: types for hover
    and definitions, from the typed tree, matched with the syntax by location.
    Files are named as in locations. *)

type t

(** [groups] are the program's modules, as checked into [checked], and [prelude]
    the toplevels of the prelude it was checked with, to find definitions in, if
    they are to be found. With [of_prelude], the program is the prelude itself,
    whose names hovers show relative to it. Raises unless [checked] recorded its
    references ([Typecheck.create]'s [record_references]). *)
val create
  :  ?prelude:Syntax.Toplevel.t list
  -> ?of_prelude:bool
  -> groups:Driver.Module_group.t list
  -> checked:Typecheck.Checked.t
  -> unit
  -> t

module Hover : sig
  type t =
    { loc : Loc.t
    ; text : string (** Markdown. *)
    }
  [@@deriving sexp_of]
end

(** About the innermost node or name at [offset] of [file]: its type, with its
    name if it is a variable or binder, or the type it names. *)
val hover : t -> file:string -> offset:int -> Hover.t option

(** Where the variable, constructor, field or type at [offset] is declared, if
    in the program's source or [create]'s [prelude]: for a value generated by a
    declaration splice, the splice. Types, constructors and fields are as the
    typechecker resolved them ([Typecheck.Checked.references]). *)
val definition : t -> file:string -> offset:int -> Loc.t option

(** Whether the variable or binder starting at [offset] is of a function type. *)
val is_function : t -> file:string -> offset:int -> bool

(** With each location [f loc], eg. to name files differently. *)
val relocate : t -> f:(Loc.t -> Loc.t) -> t

{
  "comments": {
    "blockComment": ["(*", "*)"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    [".<", ">."],
    ["struct", "end"]
  ],
  "colorizedBracketPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    [".<", ">."]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(*", "close": " *)", "notIn": ["string"] },
    { "open": "{|", "close": "|}", "notIn": ["string"] },
    { "open": ".<", "close": ">.", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "autoCloseBefore": ";:.,=}])>. \n\t",
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "(-?[0-9][0-9_]*)|(`?'?[A-Za-z_][A-Za-z0-9_']*)",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\bstruct|=|->|\\(|\\[|\\{|\\.<)\\s*(\\(\\*.*\\*\\))?\\s*$",
    "decreaseIndentPattern": "^\\s*(end\\b|\\)|\\]|\\}|>\\.)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*\\(\\*(?!.*\\*\\)).*$",
      "action": { "indent": "none", "appendText": "   " }
    }
  ]
}

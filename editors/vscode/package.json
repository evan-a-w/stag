{
  "name": "stag",
  "displayName": "stag",
  "description": "Syntax highlighting and language server client for stag, a staged ML",
  "version": "0.0.1",
  "publisher": "stag",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "stag",
        "aliases": [
          "stag"
        ],
        "extensions": [
          ".stag"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stag",
        "scopeName": "source.stag",
        "path": "./syntaxes/stag.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "stag.restartServer",
        "title": "Restart Language Server",
        "category": "stag"
      }
    ],
    "configuration": {
      "title": "stag",
      "properties": {
        "stag.serverPath": {
          "type": "string",
          "default": "stag",
          "description": "The stag executable, run as `stag lsp` for the language server and `stag fmt` for formatting. A bare name is looked up on PATH.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "build:grammar": "node scripts/build-grammar.js",
    "compile": "npm run build:grammar && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test:grammar": "vscode-tmgrammar-test 'test/grammar/*.stag' && vscode-tmgrammar-snap 'test/snap/*.stag'",
    "test:repo": "node test/scan-repo.js",
    "test:integration": "tsc -p . && node test/integration/run.js",
    "test": "npm run build:grammar && npm run typecheck && npm run test:grammar && npm run test:repo",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "js-yaml": "^4.1.0",
    "typescript": "~5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}

open! Core

(** What the typechecker infers: expressions written in the program, or code
    generated by a toplevel splice, whose types are ignored. Each is viewed one
    node at a time, so one set of rules serves both. *)

(** A binder: generated code already has its idents. *)
module Binder : sig
  type t =
    | Name of string
    | Ident of Typed.Ident.t

  val name : t -> string
end

module Constructor : sig
  type t =
    | Path of Syntax.Path.t
    | Ref of Typed.Constructor_ref.t
end

module Field : sig
  type t =
    | Path of Syntax.Path.t
    | Ref of Typed.Field_ref.t
end

module Pattern : sig
  type t =
    | Syntax of Syntax.Pattern.t
    | Generated of Typed.Pattern.t

  module Rest : sig
    type t =
      | Closed
      | Open
      | Bind of Binder.t
  end

  module View : sig
    type nonrec t =
      | Any
      | Var of Binder.t
      | Lit of Syntax.Lit.t
      | Tuple of t list
      | Construct of Constructor.t * t list
      | Record of (Field.t * t) list
      | Poly_variant of string * t option
      | Poly_record of
          { fields : (string * t) list
          ; rest : Rest.t
          }
  end

  val view : t -> View.t
end

module Expr : sig
  type t =
    | Syntax of Syntax.Expr.t
    | Generated of Typed.Expr.t

  module Var : sig
    type t =
      | Path of Syntax.Path.t * Syntax.Type_expr.t option
      | Ref of Typed.Var_ref.t
  end

  module View : sig
    type nonrec t =
      | Lit of Syntax.Lit.t
      | Var of Var.t
      | App of t * t
      | Let of
          { binder : Binder.t
          ; args : (Binder.t * Syntax.Type_expr.t option) list
          ; annot : Syntax.Type_expr.t option
          ; body : t
          ; in_ : t
          }
      | Splice of
          { code : t
          ; subs : (string * t option) list option
            (** As [Syntax.Expr.Splice]: [None] is implicit. Generated code's
              implicit providers are found again. *)
          }
      | Quote of t
      | Tuple of t list
      | Construct of Constructor.t * t list
      | Record of (Field.t * t) list
      | Field of t * Field.t
      | Match of t * (Pattern.t * t) list
      | Poly_record of (string * t) list
      | Poly_field of t * string
      | Poly_extend of (string * t) list * t
      | Poly_restrict of t * string
      | Poly_update of t * (string * t) list
      | Poly_variant of string * t option
  end

  (** Generated code is code values, so has no [Toplevel_splice]. *)
  val view : t -> View.t
end

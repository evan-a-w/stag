(* Allocation of lists and constructors: merge sort. *)

let rev_append l acc =
  match l with
  | Nil -> acc
  | Cons (x, rest) -> rev_append rest (Cons (x, acc))

let split l =
  match l with
  | Nil -> (Nil, Nil)
  | Cons (x, Nil) -> (Cons (x, Nil), Nil)
  | Cons (x, Cons (y, rest)) ->
    (match split rest with (a, b) -> (Cons (x, a), Cons (y, b)))

let merge a b =
  match (a, b) with
  | (Nil, b) -> b
  | (a, Nil) -> a
  | (Cons (x, xs), Cons (y, ys)) ->
    (match Int.le x y with
     | true -> Cons (x, merge xs b)
     | false -> Cons (y, merge a ys))

let sort l =
  match l with
  | Nil -> Nil
  | Cons (_, Nil) -> l
  | _ -> (match split l with (a, b) -> merge (sort a) (sort b))

(* Pseudo-random, by a linear congruential generator. *)
let random_list n =
  let go n seed acc =
    match Int.equal n 0 with
    | true -> acc
    | false ->
      let next = Int.rem (Int.add (Int.mul seed 1103515245) 12345) 1000003 in
      go (Int.sub n 1) next (Cons (next, acc))
  in
  go n 42 Nil

let length l = match l with Nil -> 0 | Cons (_, rest) -> Int.add 1 (length rest)

let sorted l =
  match l with
  | Nil -> true
  | Cons (_, Nil) -> true
  | Cons (x, Cons (y, rest)) ->
    (match Int.le x y with true -> sorted (Cons (y, rest)) | false -> false)

let%bench "sort" n in [100; 1000] = sort (random_list n)

let%bench "rev_append 1000" = rev_append (random_list 1000) Nil

let%expect_test "sort" =
  let l = sort (random_list 1000) in
  print_int (length l);
  print_string " ";
  print_string (match sorted l with true -> "sorted" | false -> "unsorted");
  [%expect {| 1000 sorted |}]

(* Allocation of lists and constructors: merge sort. *)

let rev_append l acc =
  match l with
  | [] -> acc
  | Cons * (x, rest) -> rev_append rest (Cons (Ptr.make ( (x, acc))))

let split l =
  match l with
  | [] -> ([], [])
  | [x] -> ([x], [])
  | Cons * (x, Cons * (y, rest)) ->
    match split rest with a, b -> (Cons (Ptr.make ( (x, a))), Cons (Ptr.make ( (y, b))))

let merge a b =
  match (a, b) with
  | [], b -> b
  | a, [] -> a
  | Cons * (x, xs), Cons * (y, ys) ->
    match Int.le x y with
    | true -> Cons (Ptr.make ( (x, merge xs b)))
    | false -> Cons (Ptr.make ( (y, merge a ys)))

let sort l =
  match l with
  | [] -> []
  | [_] -> l
  | _ -> match split l with a, b -> merge (sort a) (sort b)

(* Pseudo-random, by a linear congruential generator. *)
let random_list n =
  let go n seed acc =
    match Int.equal n 0 with
    | true -> acc
    | false ->
      let next = Int.rem (Int.add (Int.mul seed 1103515245) 12345) 1000003 in
      go (Int.sub n 1) next (Cons (Ptr.make ( (next, acc))))
  in
  go n 42 []

let length l =
  match l with
  | [] -> 0
  | Cons * (_, rest) -> Int.add 1 (length rest)

let sorted l =
  match l with
  | [] -> true
  | [_] -> true
  | Cons * (x, Cons * (y, rest)) ->
    match Int.le x y with
    | true -> sorted (Cons (Ptr.make ( (y, rest))))
    | false -> false

let list_100 = random_list 100
let list_1000 = random_list 1000

let%bench "sort 100" = sort list_100

let%bench "sort 1000" = sort list_1000

let%bench "rev_append 1000" = rev_append list_1000 []

let%expect_test "sort" =
  let l = sort (random_list 1000) in
  print_int (length l);
  print_string " ";
  print_string
    (match sorted l with
     | true -> "sorted"
     | false -> "unsorted");
  [%expect {| 1000 sorted |}]

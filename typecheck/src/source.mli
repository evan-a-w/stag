open! Import

(** What the typechecker infers: expressions written in the program, or code
    generated by a toplevel splice, whose types are ignored. Each is viewed one
    node at a time, so one set of rules serves both.

    Generated code has lost its annotations, so may be inferred more generally
    than when first inferred. Inference, including of presences and context
    bounds, is principal, so doesn't depend on the order constraints arise in,
    and decisions that depend on types are kept (see [Expr.Subs.Providers]): it
    is never inferred less generally (see proofs.md). *)

(** A binder: generated code already has its idents. *)
module Binder : sig
  type t =
    | Name of Syntax.Name.t
    | Ident of Typed.Ident.t

  val name : t -> string

  (** [enclosing], the location of the node it is in, for generated code's. *)
  val loc : t -> enclosing:Loc.t -> Loc.t
end

module Constructor : sig
  type t =
    | Path of Syntax.Decl_path.t Located.t
    | Ref of Typed.Constructor_ref.t
end

module Field : sig
  type t =
    | Path of Syntax.Decl_path.t Located.t
    | Ref of Typed.Field_ref.t
end

(** Names in views of generated code are located at the node they are in. *)
module Pattern : sig
  type t =
    | Syntax of Syntax.Pattern.t
    | Generated of Typed.Pattern.t

  module Rest : sig
    type t =
      | Closed
      | Open
      | Bind of Binder.t
  end

  module View : sig
    type nonrec t =
      | Any
      | Var of Binder.t
      | Lit of Syntax.Lit.t
      | Tuple of t list
      | Deref of t
      | Construct of Constructor.t * t list
      | Record of (Field.t * t) list
      | Poly_variant of string * t option
      | Poly_record of
          { fields : (Syntax.Name.t * t) list
          ; rest : Rest.t
          }
      | Exception of t
      (** Only written, and not at the top of a case, which is misplaced. *)
  end

  val view : t -> View.t
  val loc : t -> Loc.t

  (** The tuple of [ts], of at least two written ones: generated nodes are
      typed, so have their constructor's arity. *)
  val tuple : t list -> t
end

module Expr : sig
  type t =
    | Syntax of Syntax.Expr.t
    | Generated of Typed.Expr.t

  module Var : sig
    type t =
      | Path of Syntax.Decl_path.t * Syntax.Type_expr.t option
      | Ref of Typed.Var_ref.t
  end

  module Subs : sig
    type nonrec t =
      | Explicit of (Syntax.Name.t * t option) list
      (** As [Syntax.Expr.Splice]'s, where a name without an expression is a
          variable. *)
      | Implicit (** Each entry is provided by the binder in scope, if any. *)
      | Providers of Typed.Binder.t String.Map.t
      (** Generated code's: the binders that provided entries when the code was
          first inferred, which provide exactly those entries again. *)
  end

  module View : sig
    type nonrec t =
      | Lit of Syntax.Lit.t
      | Var of Var.t
      | App of t * t
      | Let of
          { binder : Binder.t
          ; args : (Binder.t * Syntax.Type_expr.t option) list
          ; annot : Syntax.Type_expr.t option
          ; body : t
          ; in_ : t
          }
      | Let_mut of
          { binder : Binder.t
          ; annot : Syntax.Type_expr.t option
          ; body : t
          ; in_ : t
          }
      | Assign of Var.t * t
      | Store of t * t
      | Fun of
          { args : (Binder.t * Syntax.Type_expr.t option) list
          ; body : t
          }
      | Splice of
          { code : t
          ; subs : Subs.t
          }
      | Quote of t
      | Tuple of t list
      | Deref of t
      | Construct of Constructor.t * t list
      | Record of (Field.t * t) list
      | Field of t * Field.t
      | Record_update of t * (Field.t * t) list
      | Match of
          { scrutinee : t
          ; cases : (Pattern.t * t) list
          ; exception_cases : (Pattern.t * t) list
          (** The cases [exception p], as [p]. *)
          }
      | Poly_record of (Syntax.Name.t * t) list
      | Poly_field of t * string
      | Poly_extend of (Syntax.Name.t * t) list * t
      | Poly_restrict of t * string
      | Poly_update of t * (Syntax.Name.t * t) list
      | Poly_variant of string * t option
      | Expect of string Located.t
      | Type of Syntax.Type_expr.t
      | Struct_quote of Syntax.Toplevel.t list
      | Error
  end

  (** Generated code is code values, so has no [Toplevel_splice]. *)
  val view : t -> View.t

  val loc : t -> Loc.t

  (** The tuple of [ts], of at least two written ones: generated nodes are
      typed, so have their constructor's arity. *)
  val tuple : t list -> t
end

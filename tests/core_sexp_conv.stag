(* [Core.Sexp.sexp_of], [of_sexp] and [of_sexp_raising]: ppx_sexp_conv's
   [[%sexp_of: t]] and [[%of_sexp: t]], the conversions of any type as
   syntax. The expansions show the code generated. *)

let print_sexp t = print_endline (Core.Sexp.to_string_hum t)

let print_error e =
  print_endline
    (Core.String.append "Error " (Core.Sexp.Of_sexp_error.to_string e))

let parse sexp_of of_sexp s =
  match of_sexp (Core.Sexp.of_string_exn s) with
  | Ok v -> print_sexp (sexp_of v)
  | Error e -> print_error e

let parse_raising sexp_of of_sexp s =
  match of_sexp (Core.Sexp.of_string_exn s) with
  | v -> print_sexp (sexp_of v)
  | exception Core.Sexp.Of_sexp_error e -> print_error e

module Geometry = struct
  type point = {x : int; y : int}

  include .~(Core.Sexp.derive (type point))
end

let conversions name ty = [
  Stag.Toplevel.let_
    (Core.String.append "sexp_of_" name)
    []
    (Core.Sexp.sexp_of ty);
  Stag.Toplevel.let_
    (Core.String.append name "_of_sexp")
    []
    (Core.Sexp.of_sexp ty);
  Stag.Toplevel.let_
    (Core.String.append name "_of_sexp_raising")
    []
    (Core.Sexp.of_sexp_raising ty);
]

include%inline .~(conversions "int" (type int))
  let sexp_of_int = Core.Sexp.sexp_of_int
  let int_of_sexp = Core.Sexp.int_of_sexp
  let int_of_sexp_raising = Core.Sexp.int_of_sexp_exn
end%inline

include%inline .~(conversions "ints" (type list[option[int]]))
  let sexp_of_ints =
    Core.Sexp.sexp_of_list (Core.Sexp.sexp_of_option Core.Sexp.sexp_of_int)

  let ints_of_sexp =
    Core.Sexp.list_of_sexp (Core.Sexp.option_of_sexp Core.Sexp.int_of_sexp)

  let ints_of_sexp_raising =
    Core.Sexp.list_of_sexp_exn (Core.Sexp.option_of_sexp Core.Sexp.int_of_sexp)
end%inline

include%inline .~(conversions "points" (type list[Geometry.point]))
  let sexp_of_points = Core.Sexp.sexp_of_list Geometry.sexp_of_point
  let points_of_sexp = Core.Sexp.list_of_sexp Geometry.point_of_sexp
  let points_of_sexp_raising = Core.Sexp.list_of_sexp_exn Geometry.point_of_sexp
end%inline

let%expect_test "named types are converted by their conversions" =
  print_sexp (sexp_of_int 1);
  print_sexp (sexp_of_ints [Some 1; None; Some 3]);
  print_sexp (sexp_of_points [{Geometry.x = 1; y = 2}]);
  parse sexp_of_int int_of_sexp "4";
  parse sexp_of_ints ints_of_sexp "((1) () (3))";
  parse sexp_of_points points_of_sexp "(((x 1) (y 2)) ((y 4) (x 3)))";
  parse_raising sexp_of_ints ints_of_sexp_raising "(() (5))";
  [%expect {|
    1
    ((1) () (3))
    (((x 1) (y 2)))
    4
    ((1) () (3))
    (((x 1) (y 2)) ((x 3) (y 4)))
    (() (5))
    |}]

let%expect_test "errors" =
  parse sexp_of_int int_of_sexp "a";
  parse sexp_of_ints ints_of_sexp "((1) (a))";
  parse sexp_of_points points_of_sexp "(((x 1)))";
  parse_raising sexp_of_ints ints_of_sexp_raising "((1 2))";
  [%expect {|
    Error int_of_sexp: integer needed: a
    Error int_of_sexp: integer needed: a
    Error point_of_sexp: the following record elements were undefined: y: ((x 1))
    Error option_of_sexp: list of zero or one element needed: (1 2)
    |}]

include%inline .~(conversions "sx" (type Core.Sexp.t))
  let sexp_of_sx = Core.Sexp.sexp_of_t
  let sx_of_sexp = Core.Sexp.t_of_sexp
  let sx_of_sexp_raising = Core.Sexp.t_of_sexp_exn
end%inline

include%inline .~(conversions "sexps" (type list[Core.Sexp.t]))
  let sexp_of_sexps = Core.Sexp.sexp_of_list Core.Sexp.sexp_of_t
  let sexps_of_sexp = Core.Sexp.list_of_sexp Core.Sexp.t_of_sexp
  let sexps_of_sexp_raising = Core.Sexp.list_of_sexp_exn Core.Sexp.t_of_sexp
end%inline

let%expect_test "Sexp.t is converted as itself" =
  print_sexp (sexp_of_sx (Core.Sexp.Atom "a"));
  parse sexp_of_sx sx_of_sexp "(a (b))";
  parse sexp_of_sexps sexps_of_sexp "(a (b))";
  parse_raising sexp_of_sx sx_of_sexp_raising "(a (b))";
  [%expect {|
    a
    (a (b))
    (a (b))
    (a (b))
    |}]

include%inline .~(conversions "pair" (type (int * (string * bool))))
  let sexp_of_pair =
    fun v ->
      match v with
      | v0, (v1_0, v1_1) ->
        Core.Sexp.List [
          Core.Sexp.sexp_of_int v0;
          Core.Sexp.List [
            Core.Sexp.sexp_of_string v1_0;
            Core.Sexp.sexp_of_bool v1_1;
          ];
        ]

  let pair_of_sexp =
    Core.Sexp.Deriving.catch
      (fun sexp ->
         match sexp with
         | Core.Sexp.List [v0; v1] ->
           (Core.Sexp.int_of_sexp_exn v0,
            match v1 with
            | Core.Sexp.List [v1_0; v1_1] ->
              (Core.Sexp.string_of_sexp_exn v1_0,
               Core.Sexp.bool_of_sexp_exn v1_1)
            | _ -> Core.Sexp.Deriving.tuple_error "of_sexp" 2 v1)
         | _ -> Core.Sexp.Deriving.tuple_error "of_sexp" 2 sexp)

  let pair_of_sexp_raising =
    fun sexp ->
      match sexp with
      | Core.Sexp.List [v0; v1] ->
        (Core.Sexp.int_of_sexp_exn v0,
         match v1 with
         | Core.Sexp.List [v1_0; v1_1] ->
           (Core.Sexp.string_of_sexp_exn v1_0, Core.Sexp.bool_of_sexp_exn v1_1)
         | _ -> Core.Sexp.Deriving.tuple_error "of_sexp_raising" 2 v1)
      | _ -> Core.Sexp.Deriving.tuple_error "of_sexp_raising" 2 sexp
end%inline

include%inline .~(conversions
                    "tag"
                    (type [`A | `B of int | `C of int * string]))
  let sexp_of_tag =
    let sexp_of : [`A of unit | `B of int | `C of int * string] -> Core.Sexp.t =
      fun v ->
        match v with
        | `A -> Core.Sexp.Atom "A"
        | `B v0 -> Core.Sexp.List [Core.Sexp.Atom "B"; Core.Sexp.sexp_of_int v0]
        | `C (v0_0, v0_1) ->
          Core.Sexp.List [
            Core.Sexp.Atom "C";
            Core.Sexp.List [
              Core.Sexp.sexp_of_int v0_0;
              Core.Sexp.sexp_of_string v0_1;
            ];
          ]
    in
    sexp_of

  let tag_of_sexp =
    let of_sexp : Core.Sexp.t ->
        result[[`A of unit | `B of int | `C of int * string],
               Core.Sexp.Of_sexp_error.t] =
      Core.Sexp.Deriving.catch
        (fun sexp ->
           match sexp with
           | Core.Sexp.Atom "A" -> `A
           | Core.Sexp.List [Core.Sexp.Atom "B"; v0] ->
             `B (Core.Sexp.int_of_sexp_exn v0)
           | Core.Sexp.List [Core.Sexp.Atom "C"; v0] ->
             `C
               (match v0 with
                | Core.Sexp.List [v0_0; v0_1] ->
                  (Core.Sexp.int_of_sexp_exn v0_0,
                   Core.Sexp.string_of_sexp_exn v0_1)
                | _ -> Core.Sexp.Deriving.tuple_error "of_sexp" 2 v0)
           | _ ->
             Core.Sexp.Deriving.poly_variant_error
               "of_sexp"
               ["A"]
               ["B"; "C"]
               sexp)
    in
    of_sexp

  let tag_of_sexp_raising =
    let of_sexp_raising : Core.Sexp.t ->
        [`A of unit | `B of int | `C of int * string] =
      fun sexp ->
        match sexp with
        | Core.Sexp.Atom "A" -> `A
        | Core.Sexp.List [Core.Sexp.Atom "B"; v0] ->
          `B (Core.Sexp.int_of_sexp_exn v0)
        | Core.Sexp.List [Core.Sexp.Atom "C"; v0] ->
          `C
            (match v0 with
             | Core.Sexp.List [v0_0; v0_1] ->
               (Core.Sexp.int_of_sexp_exn v0_0,
                Core.Sexp.string_of_sexp_exn v0_1)
             | _ -> Core.Sexp.Deriving.tuple_error "of_sexp_raising" 2 v0)
        | _ ->
          Core.Sexp.Deriving.poly_variant_error
            "of_sexp_raising"
            ["A"]
            ["B"; "C"]
            sexp
    in
    of_sexp_raising
end%inline

include%inline .~(conversions "tags" (type list[[`A | `B of int]]))
  let sexp_of_tags =
    let sexp_of : list[[`A of unit | `B of int]] -> Core.Sexp.t =
      Core.Sexp.sexp_of_list
        (fun v ->
           match v with
           | `A -> Core.Sexp.Atom "A"
           | `B v0 ->
             Core.Sexp.List [Core.Sexp.Atom "B"; Core.Sexp.sexp_of_int v0])
    in
    sexp_of

  let tags_of_sexp =
    let of_sexp : Core.Sexp.t ->
        result[list[[`A of unit | `B of int]], Core.Sexp.Of_sexp_error.t] =
      Core.Sexp.list_of_sexp
        (Core.Sexp.Deriving.catch
           (fun sexp ->
              match sexp with
              | Core.Sexp.Atom "A" -> `A
              | Core.Sexp.List [Core.Sexp.Atom "B"; v0] ->
                `B (Core.Sexp.int_of_sexp_exn v0)
              | _ ->
                Core.Sexp.Deriving.poly_variant_error
                  "of_sexp"
                  ["A"]
                  ["B"]
                  sexp))
    in
    of_sexp

  let tags_of_sexp_raising =
    let of_sexp_raising : Core.Sexp.t -> list[[`A of unit | `B of int]] =
      Core.Sexp.list_of_sexp_exn
        (Core.Sexp.Deriving.catch
           (fun sexp ->
              match sexp with
              | Core.Sexp.Atom "A" -> `A
              | Core.Sexp.List [Core.Sexp.Atom "B"; v0] ->
                `B (Core.Sexp.int_of_sexp_exn v0)
              | _ ->
                Core.Sexp.Deriving.poly_variant_error
                  "of_sexp_raising"
                  ["A"]
                  ["B"]
                  sexp))
    in
    of_sexp_raising
end%inline

let%expect_test "tuples and polymorphic variants are converted in place" =
  print_sexp (sexp_of_pair (1, ("a", true)));
  print_sexp (sexp_of_tag `A);
  print_sexp (sexp_of_tag (`B 1));
  print_sexp (sexp_of_tag (`C ((2, "b"))));
  print_sexp (sexp_of_tags [`A; `B 3]);
  parse sexp_of_pair pair_of_sexp "(1 (a true))";
  parse sexp_of_tag tag_of_sexp "(C (2 b))";
  parse sexp_of_tags tags_of_sexp "(A (B 3))";
  parse_raising sexp_of_tag tag_of_sexp_raising "B";
  [%expect {|
    (1 (a true))
    A
    (B 1)
    (C (2 b))
    (A (B 3))
    (1 (a true))
    (C (2 b))
    (A (B 3))
    Error of_sexp_raising: polymorphic variant tag takes an argument: B
    |}]

let%expect_test "tuple and variant errors are of the generator" =
  parse sexp_of_pair pair_of_sexp "(1 2 3)";
  parse sexp_of_tag tag_of_sexp "D";
  parse sexp_of_tag tag_of_sexp "(A 1)";
  parse_raising sexp_of_tag tag_of_sexp_raising "(B)";
  [%expect {|
    Error of_sexp: tuple of size 2 expected: (1 2 3)
    Error of_sexp: no matching variant found: D
    Error of_sexp: polymorphic variant does not take arguments: (A 1)
    Error of_sexp_raising: polymorphic variant tag "B" has incorrect number of arguments: (B)
    |}]

(* A type variable ['a] is converted by [_of_a], where the code is spliced,
   as in a struct quote's function taking it. *)
include%inline .~.< struct
  let sexp_of_tagged _of_a = .~(Core.Sexp.sexp_of (type (string * 'a)))
  let tagged_of_sexp _of_a = .~(Core.Sexp.of_sexp (type (string * 'a)))

  let tagged_of_sexp_raising _of_a =
    .~(Core.Sexp.of_sexp_raising (type (string * 'a)))

  let sexp_of_var _of_a = .~(Core.Sexp.sexp_of (type 'a))
  let var_of_sexp _of_a = .~(Core.Sexp.of_sexp (type 'a))
  let var_of_sexp_raising _of_a = .~(Core.Sexp.of_sexp_raising (type 'a))
end >.
  let sexp_of_tagged _of_a =
    fun v ->
      match v with
      | v0, v1 -> Core.Sexp.List [Core.Sexp.sexp_of_string v0; _of_a v1]

  let tagged_of_sexp _of_a =
    Core.Sexp.Deriving.catch
      (fun sexp ->
         match sexp with
         | Core.Sexp.List [v0; v1] ->
           (Core.Sexp.string_of_sexp_exn v0, Core.Sexp.of_sexp_exn _of_a v1)
         | _ -> Core.Sexp.Deriving.tuple_error "of_sexp" 2 sexp)

  let tagged_of_sexp_raising _of_a =
    fun sexp ->
      match sexp with
      | Core.Sexp.List [v0; v1] ->
        (Core.Sexp.string_of_sexp_exn v0, Core.Sexp.of_sexp_exn _of_a v1)
      | _ -> Core.Sexp.Deriving.tuple_error "of_sexp_raising" 2 sexp

  let sexp_of_var _of_a = _of_a
  let var_of_sexp _of_a = _of_a
  let var_of_sexp_raising _of_a = Core.Sexp.of_sexp_exn _of_a
end%inline

let%expect_test "type variables" =
  print_sexp (sexp_of_tagged Core.Sexp.sexp_of_int ("a", 1));
  parse
    (sexp_of_tagged Core.Sexp.sexp_of_int)
    (tagged_of_sexp Core.Sexp.int_of_sexp)
    "(a 1)";
  parse
    (sexp_of_tagged Core.Sexp.sexp_of_int)
    (tagged_of_sexp Core.Sexp.int_of_sexp)
    "(a b)";
  parse_raising
    (sexp_of_tagged Core.Sexp.sexp_of_int)
    (tagged_of_sexp_raising Core.Sexp.int_of_sexp)
    "(a 2)";
  print_sexp (sexp_of_var Core.Sexp.sexp_of_int 3);
  parse
    (sexp_of_var Core.Sexp.sexp_of_int)
    (var_of_sexp Core.Sexp.int_of_sexp)
    "a";
  parse_raising
    (sexp_of_var Core.Sexp.sexp_of_int)
    (var_of_sexp_raising Core.Sexp.int_of_sexp)
    "4";
  [%expect {|
    (a 1)
    (a 1)
    Error int_of_sexp: integer needed: b
    (a 2)
    3
    Error int_of_sexp: integer needed: a
    4
    |}]

let pairs = [(1, `X); (2, `Y)]

(* Applied where they are generated, as a declaration's body. *)
include%inline .~.< struct
  let shown = .~(Core.Sexp.sexp_of (type list[int * [`X | `Y]])) pairs
end >.
  let shown =
    (let sexp_of : list[int * [`X of unit | `Y of unit]] -> Core.Sexp.t =
       Core.Sexp.sexp_of_list
         (fun v ->
            match v with
            | v0, v1 ->
              Core.Sexp.List [
                Core.Sexp.sexp_of_int v0;
                (match v1 with
                 | `X -> Core.Sexp.Atom "X"
                 | `Y -> Core.Sexp.Atom "Y");
              ])
     in
     sexp_of)
      pairs
end%inline

let%expect_test "applied" =
  print_sexp shown;
  [%expect {| ((1 X) (2 Y)) |}]

(* A local [Core] or conversion of the same name where the code is spliced
   doesn't capture what it refers to. *)
module Shadowing = struct
  module Core = struct end

  let sexp_of_int (i : int) = "shadowed"

  include%inline .~(conversions "ints" (type list[int]))
    let sexp_of_ints = .Core.Sexp.sexp_of_list .Core.Sexp.sexp_of_int
    let ints_of_sexp = .Core.Sexp.list_of_sexp .Core.Sexp.int_of_sexp

    let ints_of_sexp_raising =
      .Core.Sexp.list_of_sexp_exn .Core.Sexp.int_of_sexp
  end%inline

  let direct = .~(.Core.Sexp.sexp_of (type list[int])) [3; 4]
end

let%expect_test "shadowing" =
  print_sexp (Shadowing.sexp_of_ints [1; 2]);
  print_sexp Shadowing.direct;
  [%expect {|
    (1 2)
    (3 4)
    |}]

(* Spliced directly as expressions, as [[%sexp_of: t]] is used. *)
let direct =
  .~(Core.Sexp.sexp_of (type list[int * Geometry.point]))
    [(1, {Geometry.x = 2; y = 3})]

let direct_of_sexp sexp =
  .~(Core.Sexp.of_sexp (type option[[`A | `B of int]])) sexp

let direct_of_sexp_raising sexp =
  .~(Core.Sexp.of_sexp_raising (type (string * Geometry.point))) sexp

let sexp_of_pairs _of_a v = .~(Core.Sexp.sexp_of (type list[string * 'a])) v

let%expect_test "spliced as expressions" =
  print_sexp direct;
  parse
    .~(Core.Sexp.sexp_of (type option[[`A | `B of int]]))
    direct_of_sexp
    "((B 1))";
  parse
    .~(Core.Sexp.sexp_of (type option[[`A | `B of int]]))
    direct_of_sexp
    "C";
  parse_raising
    .~(Core.Sexp.sexp_of (type (string * Geometry.point)))
    direct_of_sexp_raising
    "(a ((x 1) (y 2)))";
  print_sexp (sexp_of_pairs Core.Sexp.sexp_of_bool [("a", true)]);
  [%expect {|
    ((1 ((x 2) (y 3))))
    ((B 1))
    Error option_of_sexp: list of zero or one element needed: C
    (a ((x 1) (y 2)))
    ((a true))
    |}]

(* A conversion using itself, by a splice in its own body. *)
type tree = Leaf of int | Node of list[tree]

let sexp_of_tree t =
  match t with
  | Leaf n -> .~(Core.Sexp.sexp_of (type (string * int))) ("Leaf", n)
  | Node ts ->
    Core.Sexp.List [
      Core.Sexp.Atom "Node";
      .~(Core.Sexp.sexp_of (type list[tree])) ts;
    ]

let%expect_test "recursive" =
  print_sexp (sexp_of_tree (Node [Leaf 1; Node [Leaf 2]; Node []]));
  [%expect {| (Node ((Leaf 1) (Node ((Leaf 2))) (Node ()))) |}]

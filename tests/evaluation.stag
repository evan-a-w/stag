(* Evaluation of closures, recursion and staged code. *)

let print_pair p =
  match p with
  | a, b ->
    print_char '(';
    print_int a;
    print_string ", ";
    print_int b;
    print_char ')'

let print_bool b =
  match b with
  | true -> print_string "true"
  | false -> print_string "false"

let print_nat n =
  match n with
  | `Z -> print_string "Z"
  | `S *m ->
    print_string "S ";
    print_nat m

module Application = struct
  let pair a b = (a, b)
  let applied = pair 1 2
  let partial = pair 1
  let partial_twice = (partial 2, partial 3)

  let make x =
    let get u = x in
    get

  let closures =
    let one = make 1 in
    let two = make 2 in
    (one (), two ())

  let shadowing =
    let x = 1 in
    ((let x = 2 in x), x)

  let%expect_test "application, partial application and closures" =
    print_pair applied;
    print_endline "";
    (match partial_twice with
     | a, b ->
       print_pair a;
       print_string " ";
       print_pair b);
    print_endline "";
    print_pair closures;
    print_endline "";
    print_pair shadowing;
    [%expect {|
      (1, 2)
      (1, 2) (1, 3)
      (1, 2)
      (2, 1)
      |}]
end

module Recursion = struct
  let double n =
    match n with
    | `Z -> `Z
    | `S *m -> `S (Ptr.make (`S (Ptr.make (double m))))

  let succ n = `S (Ptr.make n)
  let doubled = double (succ (succ `Z))

  let even n =
    match n with
    | `Z -> true
    | `S *m -> odd m

  let odd n =
    match n with
    | `Z -> false
    | `S *m -> even m

  let parities = (even (succ (succ (succ `Z))), odd (succ (succ (succ `Z))))

  let local =
    let count n =
      match n with
      | `Z -> `Done
      | `S *m -> count m
    in
    count (succ (succ (succ (succ `Z))))

  let%expect_test "recursion" =
    print_nat doubled;
    print_endline "";
    (match parities with a, b -> print_bool a; print_string " "; print_bool b);
    print_endline "";
    (match local with `Done -> print_string "Done");
    [%expect {|
      S S S S Z
      false true
      Done
      |}]
end

module Toplevel_splices = struct
  let five = .~(.< 5 >.)

  (* Toplevel splices run once, while checking. *)
  let generated =
    .~(let gen n =
         match n with
         | `Z -> .< `Z >.
         | `S *m -> .< `S (Ptr.make .~(gen m)) >.
       in
       let succ n = `S (Ptr.make n) in
       gen (succ (succ (succ `Z))))

  (* The level 0 binders at the splice provide the code's context. *)
  let captured x = .~(.< (x, x) >.)
  let applied = captured 3
  let nested = .~(.~(.< .< 6 >. >.))

  let%expect_test "toplevel splices" =
    print_int five;
    print_endline "";
    print_nat generated;
    print_endline "";
    print_pair applied;
    print_endline "";
    print_int nested;
    [%expect {|
      5
      S S S Z
      (3, 3)
      6
      |}]
end

module Persistent = struct
  (* [h] is a level -1 closure, used by the level 0 code. *)
  let embedded = .~(let h y = (y, y) in .< h 1 >.)

  (* Each closure embeds what it captures, which is [const], so portable. *)
  let per_build =
    .~(let one = 1 in
       let two = 2 in
       let h1 u = one in
       let h2 u = two in
       .< (h1 (), h2 ()) >.)

  let%expect_test "persistent values in code" =
    print_pair embedded;
    print_endline "";
    print_pair per_build;
    [%expect {|
      (1, 1)
      (1, 2)
      |}]
end

module Hygiene = struct
  (* An implicit splice is provided by the innermost binder. *)
  let implicit =
    .~(let c = .< x >. in .< let x = 1 in (.~c, let x = 2 in .~c) >.)

  (* From proofs.md: [x] is the outer [y], not the code's. *)
  let explicit = .~(.< let y = 1 in .~(.< let y = 2 in (x, y) >.).{x = y} >.)

  (* Each copy of the closure [g] captures its own [x]. *)
  let copies =
    .~(let c = .< let g u = x in g () >. in
       .< ((let x = 1 in .~c), let x = 2 in .~c) >.)

  let%expect_test "hygiene" =
    print_pair implicit;
    print_endline "";
    print_pair explicit;
    print_endline "";
    print_pair copies;
    [%expect {|
      (1, 2)
      (1, 2)
      (1, 2)
      |}]
end

module Explicit_substitutions = struct
  let f y = .~(.< let g u = (x, u) in g >.).{x = y}
  let applied = f 1 2

  let%expect_test "explicit substitutions at toplevel splices" =
    print_pair applied;
    [%expect {| (1, 2) |}]
end

module Left_to_right = struct
  let%expect_test "evaluation is left to right" =
    let subs =
      .~(.<
           .~(.< (a, b) >.).{
             b = (print_string "b"; 0);
             a = (print_string "a"; 0);
           }
         >.)
    in
    print_endline "";
    let tuple = ((print_string "1"; 1), (print_string "2"; 2)) in
    [%expect {|
      ba
      12
      |}]
end

module Negative_literals = struct
  let sign n =
    match n with
    | -1 -> "minus one"
    | 0 -> "zero"
    | _ -> "other"

  let%expect_test "negative literals" =
    print_int (-5);
    print_char ' ';
    print_int (Int.add (-2) 3);
    print_char ' ';
    print_int (-4611686018427387904);
    print_char ' ';
    print_string (sign (-1));
    print_char ' ';
    print_string (sign 0);
    [%expect {| -5 1 -4611686018427387904 minus one zero |}]
end

module Provided = struct
  let n = 3
  let f u = .~(.< (n, u) >.)
  let applied = f 4

  let local x =
    let h y = (x, y) in
    let g u = .~(.< h u >.) in
    g

  let local_applied = local 5 6

  let%expect_test "toplevel splices provided by toplevels and persistent locals" =
    print_pair applied;
    print_endline "";
    print_pair local_applied;
    [%expect {|
      (3, 4)
      (5, 6)
      |}]
end

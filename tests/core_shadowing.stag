(* [Core] and the prelude's [result] are shadowable, and shadowing them does
   not change [Core] itself. *)

module List = struct
  let map f l = Nil
end

type result['a] = Ok of 'a | Error

let lengths = Core.List.map Core.String.length (Cons ("ab", Cons ("c", Nil)))

let%expect_test "Core is unaffected by the program's List and result" =
  (print_endline
     (Core.Sexp.to_string
        (Core.Sexp.sexp_of_list Core.Sexp.sexp_of_int lengths));
   print_endline
     (Core.Bool.to_string (Core.Result.is_error (Core.Sexp.of_string "(")));
   let mine = Ok 1 in
   match mine with
   | Ok n -> print_int n
   | Error ->
     print_endline "the program's Error";
     [%expect]);
  [%expect {|
    (2 1)
    true
    1
    |}]

module Inner = struct
  module Core = struct
    module List = struct
      let length l = 42
    end
  end

  let%expect_test "a program's Core shadows the core library" =
    print_int (Core.List.length Nil);
    [%expect {| 42 |}]
end

(* [Core.Map]: persistent AVL maps. *)

let print_sexp t = print_endline (Core.Sexp.to_string_hum t)

let sexp_of_bindings l =
  Core.Sexp.sexp_of_list
    (Core.Sexp.sexp_of_pair Core.Sexp.sexp_of_int Core.Sexp.sexp_of_string)
    l

let print_map m = print_sexp (sexp_of_bindings (Core.Map.to_list m))
let print_int n = print_endline (Core.Int.to_string n)
let print_bool b = print_endline (Core.Bool.to_string b)

let print_found o =
  print_sexp (Core.Sexp.sexp_of_option Core.Sexp.sexp_of_string o)

let of_list l = Core.Map.of_list Core.Int.compare l
let add m k v = Core.Map.add Core.Int.compare m k v
let find m k = Core.Map.find Core.Int.compare m k
let remove m k = Core.Map.remove Core.Int.compare m k

let both a b =
  match a with
  | true -> b
  | false -> false

(* Whether [k] is past the bound [lo] (and before [hi]), if any. *)
let after lo k =
  match lo with
  | Some lo -> Core.Int.lt lo k
  | None -> true

let before k hi =
  match hi with
  | Some hi -> Core.Int.lt k hi
  | None -> true

(* Whether [m] is an AVL tree: its keys increasing, each node's height right,
   and its children's differing by at most one. *)
let valid m =
  let check t lo hi =
    match t with
    | Core.Map.Empty -> Some 0
    | Core.Map.Node *{left = l; key = k; right = r; height = h} ->
      match
        (both (after lo k) (before k hi),
         check l lo (Some k),
         check r (Some k) hi)
      with
      | true, Some hl, Some hr ->
        (let balanced = Core.Int.le (Core.Int.abs (Core.Int.sub hl hr)) 1 in
         match
           both
             balanced
             (Core.Int.equal h (Core.Int.add 1 (Core.Int.max hl hr)))
         with
         | true -> Some h
         | false -> None)
      | _ -> None
  in
  Core.Option.is_some (check m None None)

let same_binding a b =
  match (a, b) with
  | (k1, v1), (k2, v2) -> both (Core.Int.equal k1 k2) (Core.String.equal v1 v2)

let%expect_test "add, find, remove, to_list" =
  let m = of_list [(3, "c"); (1, "a"); (2, "b"); (5, "e"); (4, "d")] in
  print_map m;
  print_int (Core.Map.cardinal m);
  print_found (find m 4);
  print_found (find m 6);
  print_bool (Core.Map.mem Core.Int.compare m 1);
  print_map (add m 3 "C");
  print_map (remove m 3);
  print_map (remove m 9);
  print_map m;
  print_bool (Core.Map.is_empty (remove (Core.Map.singleton 1 "a") 1));
  print_bool (valid m);
  [%expect {|
    ((1 a) (2 b) (3 c) (4 d) (5 e))
    5
    (d)
    ()
    true
    ((1 a) (2 b) (3 C) (4 d) (5 e))
    ((1 a) (2 b) (4 d) (5 e))
    ((1 a) (2 b) (3 c) (4 d) (5 e))
    ((1 a) (2 b) (3 c) (4 d) (5 e))
    true
    true
    |}]

let%expect_test "fold and iter go in key order" =
  let m = of_list [(2, "b"); (1, "a"); (3, "c")] in
  print_endline (Core.Map.fold (fun _ v acc -> Core.String.append acc v) m "");
  Core.Map.iter
    (fun k v ->
       print_endline (Core.String.concat "=" [Core.Int.to_string k; v]))
    m;
  [%expect {|
    abc
    1=a
    2=b
    3=c
    |}]

(* A linear congruential generator, for reproducible random operations. *)
let next seed =
  Core.Int.rem (Core.Int.add (Core.Int.mul seed 1103515245) 12345) 2147483648

(* The reference: an association list, without duplicate keys. *)
let ref_remove l k =
  Core.List.filter
    (fun kv -> match kv with k2, _ -> Core.Bool.not (Core.Int.equal k k2))
    l

let ref_add l k v = Cons (Box.make ((k, v), ref_remove l k))

let ref_sorted l =
  Core.List.sort
    (fun a b -> match (a, b) with (x, _), (y, _) -> Core.Int.compare x y)
    l

let agree m l =
  both
    (valid m)
    (Core.List.equal same_binding (Core.Map.to_list m) (ref_sorted l))

let%expect_test "random operations agree with an association list, and stay balanced" =
  let run n seed m l bad =
    match n with
    | 0 -> (m, l, bad)
    | _ ->
      let s1 = next seed in
      let k = Core.Int.rem (Core.Int.div s1 65536) 64 in
      let s2 = next s1 in
      let step =
        match Core.Int.rem (Core.Int.div s2 65536) 3 with
        | 0 -> (remove m k, ref_remove l k)
        | _ ->
          let v = Core.Int.to_string s2 in
          (add m k v, ref_add l k v)
      in
      match step with
      | m, l ->
        run
          (Core.Int.sub n 1)
          s2
          m
          l
          (match agree m l with
           | true -> bad
           | false -> Core.Int.add bad 1)
  in
  (match run 2000 42 Core.Map.empty [] 0 with
   | m, l, bad ->
     print_int bad;
     print_int (Core.Map.cardinal m);
     print_int (Core.Map.height m);
     print_bool (agree m l));
  [%expect {|
    0
    38
    6
    true
    |}]

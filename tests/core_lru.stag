(* [Core.Lru]: least-recently-used caches. *)

let print_sexp t = print_endline (Core.Sexp.to_string_hum t)

let sexp_of_bindings l =
  Core.Sexp.sexp_of_list
    (Core.Sexp.sexp_of_pair Core.Sexp.sexp_of_string Core.Sexp.sexp_of_int)
    l

let print_cache c = print_sexp (sexp_of_bindings (Core.Lru.to_list c))

let print_found o =
  print_sexp (Core.Sexp.sexp_of_option Core.Sexp.sexp_of_int o)

let%expect_test "most recently used first, the least recently used evicted" =
  let c = Core.Lru.create 3 Core.String.compare in
  Core.Lru.add c "a" 1;
  Core.Lru.add c "b" 2;
  Core.Lru.add c "c" 3;
  print_cache c;
  print_found (Core.Lru.find c "a");
  print_cache c;
  Core.Lru.add c "d" 4;
  print_cache c;
  print_found (Core.Lru.find c "b");
  Core.Lru.add c "c" 30;
  print_cache c;
  print_endline (Core.Int.to_string (Core.Lru.length c));
  [%expect {|
    ((c 3) (b 2) (a 1))
    (1)
    ((a 1) (c 3) (b 2))
    ((d 4) (a 1) (c 3))
    ()
    ((c 30) (d 4) (a 1))
    3
    |}]

let%expect_test "capacity one" =
  let c = Core.Lru.create 1 Core.String.compare in
  Core.Lru.add c "a" 1;
  Core.Lru.add c "b" 2;
  print_cache c;
  print_found (Core.Lru.find c "a");
  print_found (Core.Lru.find c "b");
  [%expect {|
    ((b 2))
    ()
    (2)
    |}]

let print_bool b = print_endline (Core.Bool.to_string b)

let%expect_test "remove, mem and clear" =
  let c = Core.Lru.create 3 Core.String.compare in
  Core.Lru.add c "a" 1;
  Core.Lru.add c "b" 2;
  Core.Lru.add c "c" 3;
  print_bool (Core.Lru.mem c "b");
  Core.Lru.remove c "b";
  print_bool (Core.Lru.mem c "b");
  Core.Lru.remove c "z";
  print_cache c;
  print_endline (Core.Int.to_string (Core.Lru.length c));
  Core.Lru.remove c "c";
  Core.Lru.remove c "a";
  print_cache c;
  Core.Lru.add c "d" 4;
  Core.Lru.add c "e" 5;
  print_cache c;
  Core.Lru.clear c;
  print_cache c;
  print_endline (Core.Int.to_string (Core.Lru.length c));
  print_found (Core.Lru.find c "d");
  Core.Lru.add c "f" 6;
  print_cache c;
  [%expect {|
    true
    false
    ((c 3) (a 1))
    2
    ()
    ((e 5) (d 4))
    ()
    0
    ()
    ((f 6))
    |}]

let%expect_test "mem doesn't use the key" =
  let c = Core.Lru.create 2 Core.String.compare in
  Core.Lru.add c "a" 1;
  Core.Lru.add c "b" 2;
  print_bool (Core.Lru.mem c "a");
  Core.Lru.add c "c" 3;
  print_cache c;
  [%expect {|
    true
    ((c 3) (b 2))
    |}]

let%expect_test "capacity zero keeps nothing; a negative one is refused" =
  let c = Core.Lru.create 0 Core.String.compare in
  Core.Lru.add c "a" 1;
  print_cache c;
  print_endline (Core.Int.to_string (Core.Lru.length c));
  (match Core.Lru.create (-1) Core.String.compare with
   | _ -> print_endline "created"
   | exception Failure message -> print_endline message);
  [%expect {|
    ()
    0
    Lru.create: negative capacity
    |}]

let%expect_test "found by a key on the stack" =
  let compare (a : box[int] @ local) (b : box[int] @ local) =
    match (a, b) with *x, *y -> Core.Int.compare x y
  in
  let c = Core.Lru.create 2 compare in
  Core.Lru.add c (Box.make 1) 10;
  Core.Lru.add c (Box.make 2) 20;
  let find (n : int) =
    let k = stack_ Box.make n in
    Core.Lru.find c k [@nontail]
  in
  print_found (find 1);
  print_found (find 3);
  print_bool (Core.Lru.mem c (stack_ Box.make 2));
  Core.Lru.remove c (stack_ Box.make 2);
  print_bool (Core.Lru.mem c (stack_ Box.make 2));
  [%expect {|
    (10)
    ()
    true
    false
    |}]

let both a b =
  match a with
  | true -> b
  | false -> false

let same_binding a b =
  match (a, b) with
  | (k1, v1), (k2, v2) -> both (Core.String.equal k1 k2) (Core.Int.equal v1 v2)

let same_found a b =
  match (a, b) with
  | None, None -> true
  | Some x, Some y -> Core.Int.equal x y
  | _ -> false

(* The reference: the bindings, most recently used first. *)
let ref_without l k =
  Core.List.filter
    (fun kv -> match kv with k2, _ -> Core.Bool.not (Core.String.equal k k2))
    l

let ref_find l k =
  match Core.List.assoc Core.String.equal k l with
  | None -> (None, l)
  | Some v -> (Some v, Cons (Box.make ((k, v), ref_without l k)))

let ref_add capacity l k v =
  Core.List.take capacity (Cons (Box.make ((k, v), ref_without l k)))

let next seed =
  Core.Int.rem (Core.Int.add (Core.Int.mul seed 1103515245) 12345) 2147483648

let%expect_test "random operations agree with a list" =
  let capacity = 8 in
  let c = Core.Lru.create capacity Core.String.compare in
  let run n seed l bad =
    match n with
    | 0 -> (l, bad)
    | _ ->
      let s1 = next seed in
      let k = Core.Int.to_string (Core.Int.rem (Core.Int.div s1 65536) 16) in
      let s2 = next s1 in
      let step =
        match Core.Int.rem (Core.Int.div s2 65536) 4 with
        | 0 ->
          (match ref_find l k with
           | expected, l -> (same_found expected (Core.Lru.find c k), l))
        | 2 ->
          Core.Lru.remove c k;
          (true, ref_without l k)
        | _ ->
          Core.Lru.add c k s2;
          (true, ref_add capacity l k s2)
      in
      match step with
      | found_ok, l ->
        let ok =
          both found_ok (Core.List.equal same_binding (Core.Lru.to_list c) l)
        in
        run
          (Core.Int.sub n 1)
          s2
          l
          (match ok with
           | true -> bad
           | false -> Core.Int.add bad 1)
  in
  (match run 2000 7 [] 0 with
   | l, bad ->
     print_endline (Core.Int.to_string bad);
     print_endline (Core.Int.to_string (Core.List.length l));
     print_endline (Core.Int.to_string (Core.Lru.length c)));
  [%expect {|
    0
    8
    8
    |}]

let ext (s : string) =
  let e @ external = s in
  e

let%expect_test "keys may be external, as C strings" =
  let c : Core.Lru.t[string, int, external] =
    Core.Lru.create 2 Core.String.compare
  in
  Core.Lru.add c (ext "a") 1;
  Core.Lru.add c (ext "b") 2;
  Core.Lru.add c (ext "c") 3;
  print_cache c;
  print_found (Core.Lru.find c "a");
  print_found (Core.Lru.find c (ext "b"));
  Core.Lru.remove c "c";
  print_cache c;
  [%expect {|
    ((c 3) (b 2))
    ()
    (2)
    ((b 2))
    |}]

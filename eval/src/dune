(library
 (name stag_eval)
 (preprocess
  (pps ppx_jane))
 (libraries core stag_common stag_syntax stag_ir))

(rule
 (target prelude_source.ml)
 (deps prelude/stag.stag)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let source = {stag_prelude|")
    (cat prelude/stag.stag)
    (echo "|stag_prelude}\n")))))

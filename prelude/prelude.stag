(* The prelude, in scope in every program, outside its root module, so the
   program's declarations shadow it. *)

(* An immutable block holding its contents: [Box.make x], read as [b.*] or the
   pattern [*x]. Unlike a [ptr], it is covariant in its contents' modes. *)
type box['a]

type list['a] = Nil | Cons of box['a * list['a]]
type option['a] = None | Some of 'a
type result['a, 'e] = Ok of 'a | Error of 'e

(* Raised by prims on errors in their arguments. *)
exception Division_by_zero
exception Invalid_argument of string
exception Failure of string

let raise = Intrinsic.raise

module Ptr = struct
  let make = Intrinsic.ptr_make
end

module Box = struct
  let make = Intrinsic.box_make
end

module Unsafe = struct
  (* The caller vouches that the value outlives every region. *)
  let assume_global = Intrinsic.assume_global
end

module Stag = struct
  (* The syntax of stag as data, mirroring [Syntax], for declarations generated
     at compile time. Names are as written, without backticks or quotes: [x],
     [C], [`A] as ["A"], ['a] as ["a"]. Paths are names joined with [.], as
     ["M.x"]. *)

  let map f l =
    match l with
    | [] -> []
    | Cons *(x, rest) -> Cons (Box.make (f x, map f rest))

  let append l tail =
    match l with
    | Nil -> tail
    | Cons *(x, rest) -> Cons (Box.make (x, append rest tail))

  (* Declared types, constructors and fields, by identity: a ref names the
     same declaration wherever it is spliced, whatever is in scope there. Only
     reflection ([Type]) makes them. [name] is the name it is declared with,
     eg. ["C"]. *)
  module Type_ref = struct
    type t

    let name = Intrinsic.type_ref_name

    (* The names of its path from the root scope: of the program's, eg.
       [Program ["A"; "M"; "t"]] for the [t] of module [M] of file [a.stag], or
       of the prelude's, eg. [Prelude ["Core"; "Sexp"; "t"]], and
       [Prelude ["int"]] for a builtin type. *)
    module Path = struct
      type t = Program of list[string] | Prelude of list[string]
    end

    let path = Intrinsic.type_ref_path
  end

  module Constructor_ref = struct
    type t

    let name = Intrinsic.constructor_ref_name
  end

  module Field_ref = struct
    type t

    let name = Intrinsic.field_ref_name
  end

  (* A toplevel value, or a prim. Only [Code.erase] makes them. *)
  module Value_ref = struct
    type t

    let name = Intrinsic.value_ref_name
  end

  (* What names a type, constructor, field or value (['r] is [Type_ref.t],
     [Constructor_ref.t], [Field_ref.t] or [Value_ref.t]): a path, resolved
     where the syntax is spliced, or a ref. *)
  module Path = struct
    type t['r] = Name of string | Ref of 'r
  end

  module Internal = struct
    let constructor code =
      match Intrinsic.erase code with
      | Expr.Construct (c, _) -> c
      | _ -> raise (Failure "Stag.Internal.constructor")

    let cons = constructor .< [()] >.
    let nil = constructor .< [] >.
    let box_make =
      match Intrinsic.erase .< Box.make >. with
      | Expr.Var (ref_, _) -> ref_
      | _ -> raise (Failure "Stag.Internal.box_make")
  end

  module Lit = struct
    type t = Int of int | Bool of bool | String of string | Char of char | Unit
  end

  (* A mode as written after [@]: [@ 'm], standing for every axis, or
     [@ local portable], at most one of each axis. *)
  module Mode_expr = struct
    module Axis = struct
      type t = Stage | Provenance | Locality
    end

    module Atom = struct
      type t =
        | Const
        | Portable
        | Nonportable
        | Static
        | Gc
        | External
        | Global
        | Regional
        | Local
    end

    type t = Var of string | Atoms of list[Atom.t]

    (* A side of a constraint [lower <= upper]: a mode, on every axis, or a
       variable on one axis, [Axis], under functions: [meet] and [release] on
       the left of [<=], [static_if_const] and [const_if_static] on the
       right. *)
    module Term = struct
      type t =
        | Mode of Mode_expr.t
        | Axis of Axis.t * Mode_expr.t
        | Meet of ptr[t * Atom.t]
        | Release of ptr[t]
        | Static_if_const of ptr[t]
        | Const_if_static of ptr[t]
    end
  end

  module Type_expr = struct
    type t =
      | Var of string
      | Con of Path.t[Type_ref.t] * list[Arg.t]
      | Arrow of ptr[t * t]
      | Tuple of list[t]
      | Code of ptr[{`inner : t; `context : Row.t}]
      | Record of Row.t
      | Variant of Row.t
      (* [mut t] and [immut t], the type of a context entry the code assigns
         and doesn't assign. Without either, it may or may not. *)
      | Mut of ptr[t]
      | Immut of ptr[t]
      | Splice of ptr[Expr.t]
      (* [t @ m], only as a function type's argument or result. *)
      | Moded of ptr[t * Mode_expr.t]
      (* [t with c and ...], only as an annotation's type: each constraint
         [(lower, upper)] is [lower <= upper], at least one a variable. *)
      | Constrained of ptr[t * list[Mode_expr.Term.t * Mode_expr.Term.t]]
      (* [t @@ m], only as a record field's type, a constructor's argument or
         a pointer's type argument. *)
      | Modality of ptr[t * Mode_expr.t]

    (* Labels are those of polymorphic records and variants, except in the
       context of a code type, whose entries are variables. *)
    module Row = struct
      type t = Empty | Extend of ptr[string * Type_expr.t * t] | Var of string
    end

    module Arg = struct
      (* [Mode], a mode argument of more than one atom: one of one atom or a
         variable is a [Ty], which the declaration's parameters may make a
         mode. *)
      type t = Ty of Type_expr.t | Row of Row.t | Mode of Mode_expr.t
    end

    (* [con "list" [t]] is [list[t]]. *)
    let con name args =
      let ty t = Arg.Ty t in
      Con (Path.Name name, map ty args)

    (* [tuple] of no types is [unit], of one is that type. *)
    let tuple ts =
      match ts with
      | [] -> con "unit" []
      | [t] -> t
      | _ -> Tuple ts
  end

  module Type_decl = struct
    module Param = struct
      type t = Ty of string | Row of string | Mode of string
    end

    module Kind = struct
      type t =
        | Variant of list[string * list[Type_expr.t]]
        | Record of list[string * Type_expr.t]
        | Alias of Type_expr.t
        | Abstract
        | Splice of Expr.t
    end

    type t = {`name : string; `params : list[Param.t]; `kind : Kind.t}
  end

  (* [: t @ m] of a binder or a variable, each part optional. *)
  module Annot = struct
    type t = {`ty : option[Type_expr.t]; `mode : option[Mode_expr.t]}

    let none : t = {`ty = None; `mode = None}

    let ty t : t = {`ty = Some t; `mode = None}
  end

  module Binding = struct
    type t = string * Annot.t
  end

  module Pattern = struct
    module Rest = struct
      type t = Closed | Open | Bind of string
    end

    type t =
      | Any
      | Var of string
      | Lit of Lit.t
      | Tuple of list[t]
      | Construct of Path.t[Constructor_ref.t] * list[t]
      | Record of list[Path.t[Field_ref.t] * t]
      | Deref of ptr[t]
      | Poly_variant of ptr[string * option[t]]
      | Poly_record of {`fields : list[string * t]; `rest : Rest.t}
      | Exception of ptr[t]

    let construct name args = Construct (Path.Name name, args)

    (* The list literal of [ps], [[p1; p2]], of the prelude's [Cons] and
       [Nil] wherever it is spliced. *)
    let list ps =
      match ps with
      | [] -> Construct (Internal.nil, [])
      | Cons *(p, rest) ->
        Construct (Internal.cons, [Deref (Ptr.make (Tuple [p; list rest]))])

    (* [tuple] of no patterns is [()], of one is that pattern. *)
    let tuple ps =
      match ps with
      | [] -> Lit Lit.Unit
      | [p] -> p
      | _ -> Tuple ps
  end

  module Expr = struct
    type t =
      | Lit of Lit.t
      | Var of Path.t[Value_ref.t] * Annot.t
      | App of ptr[t * t]
      | Let of ptr[string * list[Binding.t] * Annot.t * t * t]
      | Let_mut of ptr[string * Annot.t * t * t]
      | Assign of ptr[Path.t[Value_ref.t] * t]
      | Store of ptr[t * t]
      | Fun of ptr[list[Binding.t] * t]
      | Splice of ptr[{`expr : t; `subs : option[list[string * option[t]]]}]
      | Quote of ptr[t]
      | Tuple of list[t]
      | Deref of ptr[t]
      | Construct of Path.t[Constructor_ref.t] * list[t]
      | Record of list[Path.t[Field_ref.t] * t]
      | Field of ptr[t * Path.t[Field_ref.t]]
      | Record_update of ptr[t * list[Path.t[Field_ref.t] * t]]
      | Type of Type_expr.t
      | Match of ptr[t * list[Pattern.t * t]]
      | Poly_record of list[string * t]
      | Poly_field of ptr[t * string]
      | Poly_extend of ptr[list[string * t] * t]
      | Poly_restrict of ptr[t * string]
      | Poly_update of ptr[t * list[string * t]]
      | Poly_variant of ptr[string * option[t]]
      | Expect of string
      | Struct_quote of list[Toplevel.t]
      | Stack of ptr[t]
      | Exclave of ptr[t]
      | Region of ptr[t]
      (* [f x [@nontail]], of an application. *)
      | Nontail of ptr[t]
      (* [(e : t @ m)], of an expression not a variable. *)
      | Annotated of ptr[t * Annot.t]
      (* [forget x, y in e]. *)
      | Forget of ptr[list[string] * t]

    let var name = Var (Path.Name name, Annot.none)
    let construct name args = Construct (Path.Name name, args)
    let int n = Lit (Lit.Int n)
    let string s = Lit (Lit.String s)

    (* [fun_ ["x"; "y"] body] is [fun x y -> body]. *)
    let fun_ params body =
      let param name = (name, Annot.none) in
      Fun (Ptr.make (map param params, body))

    let match_ e arms = Match (Ptr.make (e, arms))

    (* The list literal of [es], [[e1; e2]], as [Pattern.list]. *)
    let list es =
      match es with
      | [] -> Construct (Internal.nil, [])
      | Cons *(e, rest) ->
        Construct (Internal.cons, [App (Ptr.make (Var (Internal.box_make, Annot.none), Tuple [e; list rest]))])

    (* [apply f [x; y]] is [f x y]. *)
    let apply f args =
      match args with
      | [] -> f
      | Cons *(x, rest) -> apply (App (Ptr.make (f, x))) rest

    (* [tuple] of no expressions is [()], of one is that expression. *)
    let tuple es =
      match es with
      | [] -> Lit Lit.Unit
      | [e] -> e
      | _ -> Tuple es

    (* [let_ name params equal body] is [let name params = equal in body]. *)
    let let_ name params equal body =
      let param name = (name, Annot.none) in
      Let (Ptr.make (name, map param params, Annot.none, equal, body))
  end

  module Toplevel = struct
    type t =
      | Let of string * list[Binding.t] * Annot.t * Expr.t
      | Let_mut of string * Annot.t * Expr.t
      | Type of Type_decl.t
      | Exception of string * list[Type_expr.t]
      | External of {`name : string; `ty : Type_expr.t; `symbol : string}
      | Module of string * list[t]
      | Module_splice of string * Expr.t
      | Include of Expr.t
      | Expect_test of {`name : string; `body : Expr.t}
      | Bench of {`name : string;
                  `param : option[string * list[Expr.t]];
                  `body : Expr.t}

    (* [let_ name params body] is [let name params = body]. *)
    let let_ name params body =
      let param name = (name, Annot.none) in
      Let (name, map param params, Annot.none, body)
  end

  module Program = struct
    type t = list[Toplevel.t]
  end

  module Code = struct
    (* The syntax of the code: its free variables by name, and what it refers
       to outside it (values, prims, types, constructors and fields) by
       [Path.Ref], so it means the same wherever it is spliced. *)
    let erase = Intrinsic.erase
  end

  (* [type ty] is the type [ty] as a value, of type [Type.t[ty]]: the
     parameter is the reflected type, its variables standing for any type. *)
  module Type = struct
    type t['a]

    module Kind = struct
      type t =
        | Variant of list[Constructor_ref.t * list[Type_expr.t]]
        | Record of list[Field_ref.t * Type_expr.t]
        | Alias of Type_expr.t
    end

    module Decl = struct
      type t = {params : list[Type_decl.Param.t]; kind : Kind.t}
    end

    (* The type, its types by [Path.Ref]: [expr (type list[t])] is
       [Con (Ref list, Cons (Arg.Ty (Con (Ref t, Nil)), Nil))]. *)
    let expr = Intrinsic.type_expr

    (* The declaration of a type, checking it, its types by [Path.Ref], or
       [None] if it is abstract (as are [int] and the other builtin types).
       Only at compile time. *)
    let decl = Intrinsic.type_decl
  end
end

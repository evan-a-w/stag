(* Of the prelude's [result['a, 'e] = Ok of 'a | Error of 'e]. *)

let is_ok r =
  match r with
  | Ok _ -> true
  | Error _ -> false

let is_error r = Bool.not (is_ok r)

let map f r =
  match r with
  | Ok x -> Ok (f x)
  | Error e -> Error e

let map_error f r =
  match r with
  | Ok x -> Ok x
  | Error e -> Error (f e)

let bind r f =
  match r with
  | Ok x -> f x
  | Error e -> Error e

let join r =
  match r with
  | Ok inner -> inner
  | Error e -> Error e

let iter f r =
  match r with
  | Ok x -> f x
  | Error _ -> ()

let ok r =
  match r with
  | Ok x -> Some x
  | Error _ -> None

let error r =
  match r with
  | Ok _ -> None
  | Error e -> Some e

let ok_exn r =
  match r with
  | Ok x -> x
  | Error _ -> raise (Failure "Result.ok_exn: Error")

let of_option o error =
  match o with
  | Some x -> Ok x
  | None -> Error error

(* [Ok] of all the values, or the first [Error]. *)
let all rs =
  let loop rs acc =
    match rs with
    | [] -> Ok (List.rev acc)
    | Cons (Ok x, rest) -> loop rest (Cons (x, acc))
    | Cons (Error e, _) -> Error e
  in
  loop rs []

(* Both values combined by [ok], or the errors by [error] if both failed, or
   the one error. *)
let combine ok error r1 r2 =
  match (r1, r2) with
  | Ok x, Ok y -> Ok (ok x y)
  | Error e1, Error e2 -> Error (error e1 e2)
  | Error e, _ -> Error e
  | _, Error e -> Error e

let equal equal_ok equal_error r1 r2 =
  match (r1, r2) with
  | Ok x, Ok y -> equal_ok x y
  | Error e1, Error e2 -> equal_error e1 e2
  | _ -> false

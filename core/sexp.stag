(* S-expressions, printed and parsed exactly as by OCaml's Sexplib and
   Parsexp. *)

type t = Atom of string | List of list[t]

let equal a b =
  match (a, b) with
  | Atom x, Atom y -> String.equal x y
  | List xs, List ys -> List.equal equal xs ys
  | _ -> false

(* Sexplib's machine format: a space only between unquoted atoms, as in
   [(a"b c"(d)e()f)]. *)
let to_string t =
  (* [parts] in reverse; [space]: whether the last is an unquoted atom. *)
  let add parts space t =
    match t with
    | Atom s ->
      (match (Internal.must_escape s, space) with
       | true, _ -> (Cons (Internal.quote s, parts), false)
       | false, true -> (Cons (s, Cons (" ", parts)), true)
       | false, false -> (Cons (s, parts), true))
    | List [] -> (Cons ("()", parts), false)
    | List ts ->
      let step acc t = match acc with parts, space -> add parts space t in
      match List.fold_left step (Cons ("(", parts), false) ts with
      | parts, _ -> (Cons (")", parts), false)
  in
  match add [] false t with parts, _ -> String.concat "" (List.rev parts)

(* Sexplib's [to_string_hum]: lists that do not fit on the line are broken,
   their elements packed onto lines indented by one more than the [(], as
   OCaml's [Format] does with Sexplib's boxes. *)
let to_string_hum t =
  match Internal.Pretty.sexp_tokens t [] 0 with
  | tokens, n, _ ->
    let init = {
      `space_left = Internal.Pretty.margin;
      `indent = 0;
      `new_line = true;
      `boxes = [];
      `front = [];
      `back = [];
      `left = 0;
      `right = 0;
      `out = [];
    } in
    let outermost =
      Internal.Pretty.Token.Begin (Internal.Pretty.Box.Hov, 0, 0, -2)
    in
    let st = Internal.Pretty.run init (Cons (outermost, tokens)) n in
    String.concat "" (List.rev st.`out)

(* A syntax error, at [offset] in the string parsed, of [line] (from 1) and
   [col] (from 0). *)
module Parse_error = struct
  type t = {message : string; offset : int; line : int; col : int}

  let create s offset message =
    let count pos c =
      match (pos, c) with
      | (line, _), '\n' -> (Int.succ line, 0)
      | (line, col), _ -> (line, Int.succ col)
    in
    match String.fold_left count (1, 0) (String.prefix s offset) with
    | line, col -> {message = message; offset = offset; line = line; col = col}

  let to_string e =
    let parts = [
      "line ";
      Int.to_string e.line;
      ", column ";
      Int.to_string e.col;
      ": ";
      e.message;
    ] in
    String.concat "" parts

  let sexp_of_t e =
    List [
      Deriving.field "message" (Atom e.message);
      Deriving.field "offset" (sexp_of_int e.offset);
      Deriving.field "line" (sexp_of_int e.line);
      Deriving.field "col" (sexp_of_int e.col);
    ]

  let t_of_sexp_exn sexp =
    let name = "Core.Sexp.Parse_error.t_of_sexp" in
    let names = ["message"; "offset"; "line"; "col"] in
    match Deriving.record_fields name names sexp with
    | [message; offset; line; col] ->
      {
        message = string_of_sexp_exn message;
        offset = int_of_sexp_exn offset;
        line = int_of_sexp_exn line;
        col = int_of_sexp_exn col;
      }

  let t_of_sexp sexp = Deriving.catch t_of_sexp_exn sexp
end

(* Parsexp's [Single.parse_string]: the one sexp of [s], possibly surrounded by
   whitespace and comments. *)
let of_string s =
  match Internal.Parser.between s 0 (Internal.Parser.Context.create true) with
  | Ok (Cons (t, _)) -> Ok t
  | Ok [] -> Error (Parse_error.create s 0 "no s-expression found in input")
  | Error e -> Error e

(* Parsexp's [Many.parse_string]: the sexps of [s]. *)
let of_string_many s =
  Internal.Parser.between s 0 (Internal.Parser.Context.create false)

exception Parse_error of Parse_error.t

let of_string_exn s =
  match of_string s with
  | Ok t -> t
  | Error e -> raise (Parse_error e)

let of_string_many_exn s =
  match of_string_many s with
  | Ok ts -> ts
  | Error e -> raise (Parse_error e)

(* Why [*_of_sexp] failed, and the sexp it failed on, which may be within the
   one it was given. *)
module Of_sexp_error = struct
  type t = {message : string; sexp : Sexp.t}

  let create message sexp = {message = message; sexp = sexp}

  let to_string e =
    String.append e.message (String.append ": " (Sexp.to_string e.sexp))

  let sexp_of_t e =
    List [
      Deriving.field "message" (Atom e.message);
      Deriving.field "sexp" e.sexp;
    ]

  let t_of_sexp_exn sexp =
    let name = "Core.Sexp.Of_sexp_error.t_of_sexp" in
    match Deriving.record_fields name ["message"; "sexp"] sexp with
    | [message; sexp] -> {message = string_of_sexp_exn message; sexp = sexp}

  let t_of_sexp sexp = Deriving.catch t_of_sexp_exn sexp
end

exception Of_sexp_error of Of_sexp_error.t

(* [of_sexp t], raising [Of_sexp_error] if it fails, as in
   [of_sexp_exn int_of_sexp t]. *)
let of_sexp_exn of_sexp t =
  match of_sexp t with
  | Ok x -> x
  | Error e -> raise (Of_sexp_error e)

let sexp_of_unit (u : unit) = List []

let unit_of_sexp t =
  match t with
  | List [] -> Ok ()
  | _ -> Internal.of_sexp_error "unit_of_sexp: empty list needed" t

let sexp_of_bool b = Atom (Bool.to_string b)

let bool_of_sexp t =
  match t with
  | Atom "true" -> Ok true
  | Atom "True" -> Ok true
  | Atom "false" -> Ok false
  | Atom "False" -> Ok false
  | Atom _ -> Internal.of_sexp_error "bool_of_sexp: true or false needed" t
  | List _ -> Internal.of_sexp_error "bool_of_sexp: atom needed" t

let sexp_of_int n = Atom (Int.to_string n)

let int_of_sexp t =
  match t with
  | Atom s ->
    (match Int.of_string s with
     | Some n -> Ok n
     | None -> Internal.of_sexp_error "int_of_sexp: integer needed" t)
  | List _ -> Internal.of_sexp_error "int_of_sexp: atom needed" t

let sexp_of_char c = Atom (Char.to_string c)

let char_of_sexp t =
  match t with
  | Atom s ->
    (match Int.equal (String.length s) 1 with
     | true -> Ok (String.get s 0)
     | false ->
       Internal.of_sexp_error "char_of_sexp: atom of one character needed" t)
  | List _ -> Internal.of_sexp_error "char_of_sexp: atom needed" t

let sexp_of_string s = Atom s

let string_of_sexp t =
  match t with
  | Atom s -> Ok s
  | List _ -> Internal.of_sexp_error "string_of_sexp: atom needed" t

let sexp_of_list sexp_of_elt l = List (List.map sexp_of_elt l)

(* Stops at the first element that fails. *)
let list_of_sexp elt_of_sexp t =
  let loop ts acc =
    match ts with
    | [] -> Ok (List.rev acc)
    | Cons (x, rest) ->
      match elt_of_sexp x with
      | Ok y -> loop rest (Cons (y, acc))
      | Error e -> Error e
  in
  match t with
  | List ts -> loop ts []
  | Atom _ -> Internal.of_sexp_error "list_of_sexp: list needed" t

(* [None] is [()], [Some x] is [(x)]. *)
let sexp_of_option sexp_of_value o =
  match o with
  | None -> List []
  | Some x -> List [sexp_of_value x]

(* Also accepts [none], [None], [(some x)] and [(Some x)], as Sexplib does. *)
let option_of_sexp value_of_sexp t =
  let some x = Result.map Option.some (value_of_sexp x) in
  match t with
  | List [] -> Ok None
  | Atom "none" -> Ok None
  | Atom "None" -> Ok None
  | List [x] -> some x
  | List [Atom "some"; x] -> some x
  | List [Atom "Some"; x] -> some x
  | _ ->
    Internal.of_sexp_error
      "option_of_sexp: list of zero or one element needed"
      t

(* [(a b)]. *)
let sexp_of_pair sexp_of_a sexp_of_b p =
  match p with a, b -> List [sexp_of_a a; sexp_of_b b]

let pair_of_sexp a_of_sexp b_of_sexp t =
  match t with
  | List [a; b] ->
    (match (a_of_sexp a, b_of_sexp b) with
     | Ok a, Ok b ->
       let p = (a, b) in
       Ok p
     | Error e, _ -> Error e
     | _, Error e -> Error e)
  | _ -> Internal.of_sexp_error "pair_of_sexp: list of two elements needed" t

(* [(a b c)]. *)
let sexp_of_triple sexp_of_a sexp_of_b sexp_of_c p =
  match p with a, b, c -> List [sexp_of_a a; sexp_of_b b; sexp_of_c c]

let triple_of_sexp a_of_sexp b_of_sexp c_of_sexp t =
  match t with
  | List [a; b; c] ->
    (match (a_of_sexp a, b_of_sexp b, c_of_sexp c) with
     | Ok a, Ok b, Ok c ->
       let p = (a, b, c) in
       Ok p
     | Error e, _, _ -> Error e
     | _, Error e, _ -> Error e
     | _, _, Error e -> Error e)
  | _ ->
    Internal.of_sexp_error "triple_of_sexp: list of three elements needed" t

(* [(Ok x)] or [(Error e)]. *)
let sexp_of_result sexp_of_ok sexp_of_error r =
  match r with
  | Ok x -> List [Atom "Ok"; sexp_of_ok x]
  | Error e -> List [Atom "Error"; sexp_of_error e]

let result_of_sexp ok_of_sexp error_of_sexp t =
  match t with
  | List [Atom "Ok"; x] -> Result.map (fun x -> Ok x) (ok_of_sexp x)
  | List [Atom "Error"; e] -> Result.map (fun e -> Error e) (error_of_sexp e)
  | _ -> Internal.of_sexp_error "result_of_sexp: (Ok _) or (Error _) needed" t

let sexp_of_t (t : t) = t
let t_of_sexp (t : t) : result[t, Of_sexp_error.t] = Ok t

(* The conversions above, raising [Of_sexp_error] as [of_sexp_exn] does. *)
let unit_of_sexp_exn t = of_sexp_exn unit_of_sexp t
let bool_of_sexp_exn t = of_sexp_exn bool_of_sexp t
let int_of_sexp_exn t = of_sexp_exn int_of_sexp t
let char_of_sexp_exn t = of_sexp_exn char_of_sexp t
let string_of_sexp_exn t = of_sexp_exn string_of_sexp t
let list_of_sexp_exn elt_of_sexp t = of_sexp_exn (list_of_sexp elt_of_sexp) t

let option_of_sexp_exn value_of_sexp t =
  of_sexp_exn (option_of_sexp value_of_sexp) t

let result_of_sexp_exn ok_of_sexp error_of_sexp t =
  of_sexp_exn (result_of_sexp ok_of_sexp error_of_sexp) t

let t_of_sexp_exn (t : t) = t

(* As ppx_sexp_conv's [[@@deriving sexp]]: [include .~(derive (type t))]
   generates [sexp_of_t], [t_of_sexp_exn] (raising [Of_sexp_error]) and
   [t_of_sexp] (returning a [result]) for the declared type [t], each taking
   the conversions of [t]'s type parameters first ([sexp_of_t _of_a v],
   [t_of_sexp_exn _of_a sexp], [_of_a] returning a [result] for both
   [of_sexp]s). Another type [u] is converted by [sexp_of_u] and
   [u_of_sexp_exn] (or [u_of_sexp] as an argument), named bare if it is of
   [t]'s module, resolved where the code is spliced, otherwise by its root
   path ([.A.M.sexp_of_u]). See syntax.md. *)
let derive ty = Internal.Derive.derive ty

(* What the code [derive] generates uses. [name] is the [of_sexp]'s, eg.
   ["t_of_sexp"], which errors start with. *)
module Deriving = struct
  (* [(name sexp)], a record's field. *)
  let field name sexp = List [Atom name; sexp]

  let catch of_sexp_exn sexp =
    match of_sexp_exn sexp with
    | x -> Ok x
    | exception Of_sexp_error e -> Error e

  (* [sexp] with its tag ([Tag] or [(Tag ...)]) capitalized, as constructors
     are matched either way. *)
  let capitalize sexp =
    let capitalized tag =
      match String.is_empty tag with
      | true -> None
      | false ->
        let c = String.get tag 0 in
        match Char.is_lowercase c with
        | true ->
          Some (Atom
            (String.append
               (Char.to_string (Char.uppercase c))
               (String.drop_prefix tag 1)))
        | false -> None
    in
    match sexp with
    | Atom tag ->
      (match capitalized tag with
       | Some atom -> atom
       | None -> sexp)
    | List (Cons (Atom tag, args)) ->
      (match capitalized tag with
       | Some atom -> List (Cons (atom, args))
       | None -> sexp)
    | List _ -> sexp

  (* Raises the error of [sexp], which is not a variant of the constructors
     [constants] and [with_args]. *)
  let variant_error name constants with_args sexp =
    let fail message = Internal.of_sexp_fail name message sexp in
    let is_in tags tag = List.mem String.equal tag tags in
    match capitalize sexp with
    | Atom tag ->
      (match is_in with_args tag with
       | true -> fail "this constructor requires arguments"
       | false -> fail "unexpected variant constructor")
    | List (Cons (Atom tag, _)) ->
      (match (is_in constants tag, is_in with_args tag) with
       | true, _ -> fail "this constructor does not take arguments"
       | _, true ->
         fail
           (String.concat
              ""
              [
                "sum tag \"";
                String.escaped tag;
                "\" has incorrect number of arguments";
              ])
       | _ -> fail "unexpected variant constructor")
    | List (Cons (List _, _)) -> fail "a nested list is an invalid sum"
    | List [] -> fail "the empty list is an invalid sum"

  (* As [variant_error], of a polymorphic variant's [tags]. *)
  let poly_variant_error name constants with_args sexp =
    let fail message = Internal.of_sexp_fail name message sexp in
    let is_in tags tag = List.mem String.equal tag tags in
    match sexp with
    | Atom tag ->
      (match is_in with_args tag with
       | true -> fail "polymorphic variant tag takes an argument"
       | false -> fail "no matching variant found")
    | List (Cons (Atom tag, _)) ->
      (match (is_in constants tag, is_in with_args tag) with
       | true, _ -> fail "polymorphic variant does not take arguments"
       | _, true ->
         fail
           (String.concat
              ""
              [
                "polymorphic variant tag \"";
                String.escaped tag;
                "\" has incorrect number of arguments";
              ])
       | _ -> fail "no matching variant found")
    | List (Cons (List _, _)) ->
      fail "a nested list is an invalid polymorphic variant"
    | List [] -> fail "the empty list is an invalid polymorphic variant"

  let tuple_error name size sexp =
    Internal.of_sexp_fail
      name
      (String.concat "" ["tuple of size "; Int.to_string size; " expected"])
      sexp

  (* The values of the record [sexp]'s fields [names], in order. *)
  let record_fields name names sexp =
    (* The values in reverse, if the fields are [names] in order, as
       [sexp_of] gives them. *)
    let in_order names items values =
      match (names, items) with
      | [], [] -> Some values
      | Cons (name, names), Cons (List [Atom given; value], items) ->
        (match String.equal name given with
         | true -> in_order names items (Cons (value, values))
         | false -> None)
      | _ -> None
    in
    match sexp with
    | Atom _ ->
      Internal.of_sexp_fail name "list instead of atom for record expected" sexp
    | List items ->
      match in_order names items [] with
      | Some values -> List.rev values
      | None -> Internal.record_fields name names items sexp
end

(* Helpers of the functions above. *)
module Internal = struct
  (* Whether [s] must be quoted to be read back as an atom: it is empty, or has
     whitespace, a non-ASCII or control character, a parenthesis, semicolon,
     double quote or backslash, or the start or end of a block comment (hash and
     bar, either way round). *)
  let must_escape s =
    let delimits i =
      match String.get s i with
      | '(' -> true
      | ')' -> true
      | ';' -> true
      | '"' -> true
      | '\\' -> true
      | c -> Bool.not (Char.Internal.is_between '!' '~' c)
    in
    let block_comment i =
      match (String.get s i, String.get s (Int.succ i)) with
      | '#', '|' -> true
      | '|', '#' -> true
      | _ -> false
    in
    let loop i =
      match Int.lt i (String.length s) with
      | false -> false
      | true ->
        match delimits i with
        | true -> true
        | false ->
          match Int.lt (Int.succ i) (String.length s) with
          | true ->
            (match block_comment i with
             | true -> true
             | false -> loop (Int.succ i))
          | false -> false
    in
    match String.is_empty s with
    | true -> true
    | false -> loop 0

  let quote s = String.concat "" ["\""; String.escaped s; "\""]

  (* [to_string_hum]'s, as OCaml's [Format] prints what Sexplib gives it. *)
  module Pretty = struct
    module Box = struct
      (* [Format]'s [hov] (of its outermost box), [b] (of Sexplib's), and boxes
         that fit on the line. *)
      type t = Hov | B | Fits
    end

    module Token = struct
      (* [known] is, of a box or break, the number of tokens after the one whose
         enqueueing makes [Format] know its [size]. *)
      type t =
        | Text of string
        | Begin of Box.t * int * int * int
        | End
        | Break of int * int
        | Newline

      let length t =
        match t with
        | Text s -> String.length s
        | Break (_, _) -> 1
        | _ -> 0
    end

    (* [t]'s tokens consed onto [after], of [n] tokens, with their number and
       [t]'s length on one line. A list is a box indented by 1 of its elements,
       separated by breaks. A multi-line atom is a box of its lines, all but the
       last ending with a backslash, all but the first starting with [\n]. *)
    let sexp_tokens t after n =
      let text s acc =
        match acc with
        | tokens, n, width ->
          (Cons (Token.Text s, tokens),
           Int.succ n,
           Int.add width (String.length s))
      in
      (* [setter]: the number of tokens after the end of the box or the break
         after the last element. *)
      let elements rev_ts acc setter =
        match (rev_ts, acc) with
        | [], _ -> acc
        | Cons (t, rest), (tokens, n, width) ->
          match sexp_tokens t tokens n with
          | tokens, m, t_width ->
            let total = Int.add width t_width in
            match rest with
            | [] -> (tokens, m, total)
            | Cons (_, _) ->
              let break = Token.Break (Int.add t_width 2, setter) in
              elements rest (Cons (break, tokens), Int.succ m, Int.succ total) m
      in
      let lines rev_lines acc =
        match rev_lines with
        | [] -> acc
        | [l] -> text (String.escaped l) acc
        | Cons (l, rest) ->
          match text "\\n" (text (String.escaped l) acc) with
          | tokens, n, width ->
            lines
              rest
              (text "\\" (Cons (Token.Newline, tokens), Int.succ n, width))
      in
      let box offset acc =
        match acc with
        | tokens, m, width ->
          (Cons (Token.Begin (Box.B, offset, width, n), tokens),
           Int.succ m,
           width)
      in
      match t with
      | List [] -> text "()" (after, n, 0)
      | List ts ->
        let close = text ")" (Cons (Token.End, after), Int.succ n, 0) in
        box 1 (text "(" (elements (List.rev ts) close n))
      | Atom s ->
        let rev_lines = List.rev (String.split_on_char '\n' s) in
        let one_line =
          match rev_lines with
          | [_] -> true
          | [""; _] -> true
          | _ -> false
        in
        match (must_escape s, one_line) with
        | false, _ -> text s (after, n, 0)
        | true, true -> text (quote s) (after, n, 0)
        | true, false ->
          let close = text "\"" (Cons (Token.End, after), Int.succ n, 0) in
          box 0 (text " \"" (lines rev_lines close))

    let margin = 78
    let max_indent = 68
    let infinity = 1000000010
    let output st s = {st with `out = Cons (s, st.`out)}

    let new_line st width offset =
      let indent = Int.min max_indent (Int.add (Int.sub margin width) offset) in
      let out = output (output st "\n") (String.make indent ' ') in
      {out with
        `new_line = true;
        `indent = indent;
        `space_left = Int.sub margin indent;
      }

    let same_line st =
      let out = output st " " in
      {out with `space_left = Int.pred st.`space_left}

    (* [Format]'s [format_pp_token]. *)
    let format st token size =
      match token with
      | Token.Text s ->
        let out = output st s in
        {out with `space_left = Int.sub st.`space_left size; `new_line = false}
      | Token.Begin (box, offset, _, _) ->
        let indented =
          match
            (Int.gt (Int.sub margin st.`space_left) max_indent, st.`boxes)
          with
          | false, _ -> st
          | true, [] -> output st "\n"
          | true, Cons ((Box.Fits, _), _) -> st
          | true, Cons ((_, width), _) ->
            match Int.gt width st.`space_left with
            | true -> new_line st width 0
            | false -> st
        in
        let kind =
          match Int.gt size indented.`space_left with
          | true -> box
          | false -> Box.Fits
        in
        let opened = (kind, Int.sub indented.`space_left offset) in
        {indented with `boxes = Cons (opened, indented.`boxes)}
      | Token.End ->
        (match st.`boxes with
         | [] -> st
         | Cons (_, rest) -> {st with `boxes = rest})
      | Token.Newline ->
        (match st.`boxes with
         | [] -> output st "\n"
         | Cons ((_, width), _) -> new_line st width 0)
      | Token.Break (_, _) ->
        match st.`boxes with
        | [] -> st
        | Cons ((box, width), _) ->
          let fits = Int.le size st.`space_left in
          let deeper = Int.gt st.`indent (Int.sub margin width) in
          match (box, st.`new_line, fits, deeper) with
          | Box.Fits, _, _, _ -> same_line st
          | Box.Hov, _, true, _ -> same_line st
          | Box.Hov, _, false, _ -> new_line st width 0
          | Box.B, true, _, _ -> same_line st
          | Box.B, false, true, false -> same_line st
          | Box.B, false, _, _ -> new_line st width 0

    (* [Format]'s [advance_left], [now] tokens before the end: prints the
       enqueued tokens whose size is known, or that cannot fit anyway. *)
    let advance st now =
      let queue =
        match (st.`front, st.`back) with
        | [], Cons (_, _) -> {st with `front = List.rev st.`back; `back = []}
        | _ -> st
      in
      match queue.`front with
      | [] -> st
      | Cons (token, rest) ->
        let known_size =
          match token with
          | Token.Begin (_, _, size, known) ->
            (match Int.ge known now with
             | true -> Some size
             | false -> None)
          | Token.Break (size, known) ->
            (match Int.ge known now with
             | true -> Some size
             | false -> None)
          | _ -> Some (Token.length token)
        in
        let pending = Int.sub queue.`right queue.`left in
        let size =
          match (known_size, Int.ge pending queue.`space_left) with
          | Some size, _ -> Some size
          | None, true -> Some infinity
          | None, false -> None
        in
        match size with
        | None -> st
        | Some size ->
          let left = Int.add queue.`left (Token.length token) in
          advance
            (format {queue with `front = rest; `left = left} token size)
            now

    (* Enqueues [tokens], the first [now] tokens before the end, advancing after
       texts, then flushes. *)
    let run st tokens now =
      match tokens with
      | [] -> advance {st with `right = infinity} (-1)
      | Cons (token, rest) ->
        let right = Int.add st.`right (Token.length token) in
        let queued = {st with `back = Cons (token, st.`back); `right = right} in
        match token with
        | Token.Text _ -> run (advance queued now) rest (Int.pred now)
        | Token.Newline -> run (advance queued now) rest (Int.pred now)
        | _ -> run queued rest (Int.pred now)
  end

  (* Parsexp's automaton, its states functions of the offset [i] of the next
     character. *)
  module Parser = struct
    let fail s i message = Error (Parse_error.create s i message)

    module Context = struct
      (* [frames]: the elements so far, in reverse, of each list open, innermost
         first, then of the toplevel; lists in sexp comments have none.
         [ignoring]: the depths of the sexp comments ([#;]) awaiting their sexp,
         innermost first. [full]: the number of toplevel sexps. [single]: whether
         there must be exactly one. *)
      type t['sexp] = {
        single : bool;
        frames : list[list['sexp]];
        depth : int;
        ignoring : list[int];
        full : int;
      }

      let create single =
        {single = single; frames = [[]]; depth = 0; ignoring = []; full = 0}

      let ignoring ctx = Bool.not (List.is_empty ctx.ignoring)

      (* Before a sexp starts at [i]. *)
      let check_new s i ctx =
        match (ctx.single, Int.gt ctx.full 0, ignoring ctx) with
        | true, true, false -> fail s i "s-expression followed by data"
        | _ -> Ok ctx

      (* After a sexp ends at [i], in [frames] unless in a sexp comment. *)
      let added s i ctx frames depth =
        let finish ignoring comment =
          let full =
            match (comment, List.is_empty ignoring, Int.equal depth 0) with
            | false, true, true -> Int.succ ctx.full
            | _ -> ctx.full
          in
          Ok
            {
              single = ctx.single;
              frames = frames;
              depth = depth;
              ignoring = ignoring;
              full = full;
            }
        in
        match ctx.ignoring with
        | [] -> finish [] false
        | Cons (d, rest) ->
          match (Int.gt d depth, Int.equal d depth) with
          | true, _ -> fail s i "unterminated sexp comment"
          | _, true -> finish rest true
          | _ -> finish ctx.ignoring false

      let add s i ctx t =
        let frames =
          match (ignoring ctx, ctx.frames) with
          | false, Cons (frame, rest) -> Cons (Cons (t, frame), rest)
          | _ -> ctx.frames
        in
        added s i ctx frames ctx.depth

      let open_ s i ctx =
        let frames =
          match ignoring ctx with
          | false -> Cons ([], ctx.frames)
          | true -> ctx.frames
        in
        let opened ctx =
          Ok
            {
              single = ctx.single;
              frames = frames;
              depth = Int.succ ctx.depth;
              ignoring = ctx.ignoring;
              full = ctx.full;
            }
        in
        Result.bind (check_new s i ctx) opened

      let close s i ctx =
        match (Int.equal ctx.depth 0, ignoring ctx, ctx.frames) with
        | true, _, _ -> fail s i "unexpected character: ')'"
        | false, false, Cons (frame, Cons (parent, rest)) ->
          let t = List (List.rev frame) in
          added s i ctx (Cons (Cons (t, parent), rest)) (Int.pred ctx.depth)
        | false, _, _ -> added s i ctx ctx.frames (Int.pred ctx.depth)

      let start_comment ctx = {
        single = ctx.single;
        frames = ctx.frames;
        depth = ctx.depth;
        ignoring = Cons (ctx.depth, ctx.ignoring);
        full = ctx.full;
      }

      (* At the end of [s]: the toplevel sexps. *)
      let finish s ctx =
        let i = String.length s in
        match
          (Int.gt ctx.depth 0, ignoring ctx, ctx.single, ctx.full, ctx.frames)
        with
        | true, _, _, _, _ -> fail s i "unclosed parentheses at end of input"
        | _, true, _, _, _ -> fail s i "unterminated sexp comment"
        | _, _, true, 0, _ -> fail s i "no s-expression found in input"
        | _, _, _, _, Cons (top, _) -> Ok (List.rev top)
        | _, _, _, _, [] -> Ok []
    end

    let at_end s i = Bool.not (Int.lt i (String.length s))

    let next_char s i =
      match at_end s i with
      | true -> None
      | false -> Some (String.get s i)

    let is_blank c =
      match c with
      | ' ' -> true
      | '\t' -> true
      | '\012' -> true
      | _ -> false

    let ends_atom c =
      match c with
      | '\n' -> true
      | '\r' -> true
      | '(' -> true
      | ')' -> true
      | '"' -> true
      | ';' -> true
      | _ -> is_blank c

    (* [n] digits in [base] from [i]: their value and the offset after them. *)
    let escape_digits s i n base message eof_message =
      let digit c =
        let from low = Int.sub (Char.code c) (Char.code low) in
        match
          (Char.is_digit c,
           Char.Internal.is_between 'a' 'f' c,
           Char.Internal.is_between 'A' 'F' c)
        with
        | true, _, _ -> Some (from '0')
        | _, true, _ -> Some (Int.add 10 (from 'a'))
        | _, _, true -> Some (Int.add 10 (from 'A'))
        | _ -> None
      in
      let loop j value =
        match (Int.equal j (Int.add i n), at_end s j) with
        | true, _ ->
          let p = (value, j) in
          Ok p
        | _, true -> fail s j eof_message
        | _ ->
          match digit (String.get s j) with
          | Some d ->
            (match Int.lt d base with
             | true -> loop (Int.succ j) (Int.add (Int.mul value base) d)
             | false -> fail s j message)
          | None -> fail s j message
      in
      loop i 0

    let decimal_escape s i eof_message =
      let in_range p =
        match p with
        | value, j ->
          match Int.gt value 255 with
          | true ->
            fail s (Int.pred j) "escape sequence in quoted string out of range"
          | false -> Ok p
      in
      Result.bind
        (escape_digits
           s
           i
           3
           10
           "unterminated decimal escape sequence"
           eof_message)
        in_range

    let hex_escape s i eof_message =
      escape_digits
        s
        i
        2
        16
        "unterminated hexadecimal escape sequence"
        eof_message

    (* Between sexps. *)
    let between s i ctx =
      match at_end s i with
      | true -> Context.finish s ctx
      | false ->
        let next = Int.succ i in
        let start_atom ctx = atom s i next ctx in
        match String.get s i with
        | '\n' -> between s next ctx
        | '\r' -> after_cr s next ctx
        | '#' -> after_hash s next ctx
        | ';' -> line_comment s next ctx
        | '(' -> Result.bind (Context.open_ s i ctx) (between s next)
        | ')' -> Result.bind (Context.close s i ctx) (between s next)
        | '"' ->
          Result.bind
            (Context.check_new s i ctx)
            (fun ctx -> quoted s next next [] ctx)
        | c ->
          match is_blank c with
          | true -> between s next ctx
          | false -> Result.bind (Context.check_new s i ctx) start_atom

    (* A carriage return must start a CRLF. *)
    let after_cr s i ctx =
      match at_end s i with
      | true -> fail s i "unexpected end of input after carriage return"
      | false ->
        match String.get s i with
        | '\n' -> between s (Int.succ i) ctx
        | _ -> fail s i "unexpected character after carriage return"

    let line_comment s i ctx =
      match at_end s i with
      | true -> Context.finish s ctx
      | false ->
        match String.get s i with
        | '\n' -> between s (Int.succ i) ctx
        | '\r' -> after_cr s (Int.succ i) ctx
        | _ -> line_comment s (Int.succ i) ctx

    (* An unquoted atom from [start], which cannot have [#|] or [|#]. *)
    let atom s start i ctx =
      let push _ =
        Context.add s i ctx (Atom (String.sub s start (Int.sub i start)))
      in
      match at_end s i with
      | true -> Result.bind (push ()) (Context.finish s)
      | false ->
        let c = String.get s i in
        let comment_token _ =
          match String.equal (String.sub s start (Int.sub i start)) "|" with
          | true -> fail s i "illegal end of comment"
          | false -> fail s i "comment tokens in unquoted atom"
        in
        match (String.get s (Int.pred i), c) with
        | '#', '|' -> comment_token ()
        | '|', '#' -> comment_token ()
        | _ ->
          match ends_atom c with
          | true -> Result.bind (push ()) (between s i)
          | false -> atom s start (Int.succ i) ctx

    (* After a [#] starting a sexp: a sexp comment [#;], a block comment [#|],
       or an atom. *)
    let after_hash s i ctx =
      let start_atom ctx = atom s (Int.pred i) i ctx in
      match at_end s i with
      | true -> Result.bind (Context.check_new s i ctx) start_atom
      | false ->
        match String.get s i with
        | ';' -> between s (Int.succ i) (Context.start_comment ctx)
        | '|' -> block_comment s (Int.succ i) 1 ctx
        | _ -> Result.bind (Context.check_new s i ctx) start_atom

    (* A quoted atom, its parts so far in reverse in [parts], then the
       characters from [start]. *)
    let quoted s start i parts ctx =
      let with_chunk _ = Cons (String.sub s start (Int.sub i start), parts) in
      match at_end s i with
      | true -> fail s i "unterminated quoted string"
      | false ->
        match String.get s i with
        | '"' ->
          let t = Atom (String.concat "" (List.rev (with_chunk ()))) in
          Result.bind (Context.add s i ctx t) (between s (Int.succ i))
        | '\\' -> escape s (Int.succ i) (with_chunk ()) ctx
        | _ -> quoted s start (Int.succ i) parts ctx

    (* After a backslash in a quoted atom. *)
    let escape s i parts ctx =
      let eof = "unterminated quoted string" in
      let char part i = quoted s i i (Cons (part, parts)) ctx in
      let code p =
        match p with code, j -> char (Char.to_string (Prim.Char.of_code code)) j
      in
      match at_end s i with
      | true -> fail s i eof
      | false ->
        let next = Int.succ i in
        match String.get s i with
        | '\n' -> continuation s next parts ctx
        | '\r' -> escaped_cr s next parts ctx
        | 'x' -> Result.bind (hex_escape s next eof) code
        | 'n' -> char "\n" next
        | 'r' -> char "\r" next
        | 'b' -> char "\b" next
        | 't' -> char "\t" next
        | '\\' -> char "\\" next
        | '\'' -> char "'" next
        | '"' -> char "\"" next
        | c ->
          match Char.is_digit c with
          | true -> Result.bind (decimal_escape s i eof) code
          | false -> char (String.sub s (Int.pred i) 2) next

    (* After a backslash and a carriage return: a continuation if a newline
       follows, otherwise the carriage return. *)
    let escaped_cr s i parts ctx =
      match at_end s i with
      | true -> fail s i "unterminated quoted string"
      | false ->
        match String.get s i with
        | '\n' -> continuation s (Int.succ i) parts ctx
        | _ -> quoted s i i (Cons ("\r", parts)) ctx

    (* After a backslash and a newline, which skip the spaces and tabs
       following. *)
    let continuation s i parts ctx =
      match next_char s i with
      | Some ' ' -> continuation s (Int.succ i) parts ctx
      | Some '\t' -> continuation s (Int.succ i) parts ctx
      | _ -> quoted s i i parts ctx

    (* In [depth] nested block comments. *)
    let block_comment s i depth ctx =
      match at_end s i with
      | true -> fail s i "unterminated block comment"
      | false ->
        let next = Int.succ i in
        match String.get s i with
        | '"' -> comment_string s next depth ctx
        | '|' ->
          (match next_char s next with
           | Some '#' ->
             (match Int.equal depth 1 with
              | true -> between s (Int.succ next) ctx
              | false -> block_comment s (Int.succ next) (Int.pred depth) ctx)
           | _ -> block_comment s next depth ctx)
        | '#' ->
          (match next_char s next with
           | Some '|' -> block_comment s (Int.succ next) (Int.succ depth) ctx
           | _ -> block_comment s next depth ctx)
        | _ -> block_comment s next depth ctx

    (* A quoted string in a block comment, whose escapes must be valid. *)
    let comment_string s i depth ctx =
      let eof = "unterminated block comment" in
      let after p = match p with _, j -> comment_string s j depth ctx in
      match at_end s i with
      | true -> fail s i eof
      | false ->
        match String.get s i with
        | '"' -> block_comment s (Int.succ i) depth ctx
        | '\\' ->
          (let next = Int.succ i in
           match at_end s next with
           | true -> fail s next eof
           | false ->
             match String.get s next with
             | 'x' -> Result.bind (hex_escape s (Int.succ next) eof) after
             | c ->
               match Char.is_digit c with
               | true -> Result.bind (decimal_escape s next eof) after
               | false -> comment_string s (Int.succ next) depth ctx)
        | _ -> comment_string s (Int.succ i) depth ctx
  end

  let of_sexp_error message sexp = Error (Of_sexp_error.create message sexp)

  (* Raises the error [name: message] of [sexp]. *)
  let of_sexp_fail name message sexp =
    raise
      (Of_sexp_error
         (Of_sexp_error.create (String.concat ": " [name; message]) sexp))

  (* [Deriving.record_fields] of fields not in order, or wrong. *)
  let record_fields name names items sexp =
    let fail message = of_sexp_fail name message sexp in
    let listed message names =
      fail (String.append message (String.concat " " names))
    in
    let is_in names name = List.mem String.equal name names in
    let pair item =
      match item with
      | List [Atom name; value] -> (name, value)
      | _ ->
        fail
          (String.append
             "record conversion: only pairs expected, "
             "their first element must be an atom")
    in
    (* [seen] and [repeated] in reverse. *)
    let repeats names seen repeated =
      match names with
      | [] -> List.rev repeated
      | Cons (name, rest) ->
        match (is_in seen name, is_in repeated name) with
        | true, false -> repeats rest seen (Cons (name, repeated))
        | true, true -> repeats rest seen repeated
        | false, _ -> repeats rest (Cons (name, seen)) repeated
    in
    let pairs = List.map pair items in
    let given = List.map (fun p -> match p with name, _ -> name) pairs in
    let duplicates = repeats given [] [] in
    let extras = List.filter (fun name -> Bool.not (is_in names name)) given in
    let missing = List.filter (fun name -> Bool.not (is_in given name)) names in
    match (duplicates, extras, missing) with
    | Cons (_, _), _, _ -> listed "duplicate fields: " duplicates
    | _, Cons (_, _), _ -> listed "extra fields: " extras
    | _, _, Cons (_, _) ->
      listed "the following record elements were undefined: " missing
    | _ -> List.map (fun name -> List.assoc_exn String.equal name pairs) names

  (* The code generator of [derive]. What it refers to in [Core] is named by
     the refs of erased quotes, so the code means the same wherever it is
     spliced. *)
  module Derive = struct
    module Dir = struct
      type t = To_sexp | Of_sexp | Of_sexp_exn

      (* The converter's name of the type [name], eg. [sexp_of_t]. *)
      let conv_name dir name =
        match dir with
        | To_sexp -> String.append "sexp_of_" name
        | Of_sexp -> String.append name "_of_sexp"
        | Of_sexp_exn -> String.append name "_of_sexp_exn"
    end

    module Context = struct
      (* [self]: the path of the derived type's module, whose types are named
         bare; [name]: the derived [of_sexp]'s, in errors. *)
      type t = {self : list[string]; name : string}
    end

    (* A constructor or polymorphic variant tag, and how to construct and
       match it of its arguments. *)
    module Case = struct
      type t = {
        tag : string;
        args : list[Stag.Type_expr.t];
        construct : list[Stag.Expr.t] -> Stag.Expr.t;
        pattern : list[Stag.Pattern.t] -> Stag.Pattern.t;
      }
    end

    let fail message = raise (Failure (String.append "Sexp.derive: " message))
    let erase code = Stag.Code.erase code
    let var name = Stag.Expr.var name
    let pvar name = Stag.Pattern.Var name
    let apply f args = Stag.Expr.apply f args

    let constructor code = match erase code with Stag.Expr.Construct (c, _) -> c

    let atom_c = constructor .< Atom "" >.
    let list_c = constructor .< List [] >.
    let atom tag = Stag.Expr.Construct (atom_c, [Stag.Expr.string tag])

    let atom_pattern tag =
      Stag.Pattern.Construct (atom_c, [Stag.Pattern.Lit (Stag.Lit.String tag)])

    let sexp_list es = Stag.Expr.Construct (list_c, [Stag.Expr.list es])

    let list_pattern ps =
      Stag.Pattern.Construct (list_c, [Stag.Pattern.list ps])

    let strings ss = Stag.Expr.list (List.map Stag.Expr.string ss)

    let fst p = match p with x, _ -> x
    let snd p = match p with _, y -> y

    (* [prefix0], [prefix1], ... *)
    let vars prefix n =
      List.init n (fun i -> String.append prefix (Int.to_string i))

    (* The conversion of a type parameter ['a]. *)
    let param_conv a = String.append "_of_" a

    (* The prelude's types that have conversions, by path. *)
    module Builtin = struct
      type t = {
        path : list[string];
        to_sexp : Stag.Expr.t;
        of_sexp : Stag.Expr.t;
        of_sexp_exn : Stag.Expr.t;
      }

      let all = [
        {
          path = ["unit"];
          to_sexp = erase .< sexp_of_unit >.;
          of_sexp = erase .< unit_of_sexp >.;
          of_sexp_exn = erase .< unit_of_sexp_exn >.;
        };
        {
          path = ["bool"];
          to_sexp = erase .< sexp_of_bool >.;
          of_sexp = erase .< bool_of_sexp >.;
          of_sexp_exn = erase .< bool_of_sexp_exn >.;
        };
        {
          path = ["int"];
          to_sexp = erase .< sexp_of_int >.;
          of_sexp = erase .< int_of_sexp >.;
          of_sexp_exn = erase .< int_of_sexp_exn >.;
        };
        {
          path = ["char"];
          to_sexp = erase .< sexp_of_char >.;
          of_sexp = erase .< char_of_sexp >.;
          of_sexp_exn = erase .< char_of_sexp_exn >.;
        };
        {
          path = ["string"];
          to_sexp = erase .< sexp_of_string >.;
          of_sexp = erase .< string_of_sexp >.;
          of_sexp_exn = erase .< string_of_sexp_exn >.;
        };
        {
          path = ["list"];
          to_sexp = erase .< sexp_of_list >.;
          of_sexp = erase .< list_of_sexp >.;
          of_sexp_exn = erase .< list_of_sexp_exn >.;
        };
        {
          path = ["option"];
          to_sexp = erase .< sexp_of_option >.;
          of_sexp = erase .< option_of_sexp >.;
          of_sexp_exn = erase .< option_of_sexp_exn >.;
        };
        {
          path = ["result"];
          to_sexp = erase .< sexp_of_result >.;
          of_sexp = erase .< result_of_sexp >.;
          of_sexp_exn = erase .< result_of_sexp_exn >.;
        };
        {
          path = ["Core"; "Sexp"; "t"];
          to_sexp = erase .< sexp_of_t >.;
          of_sexp = erase .< t_of_sexp >.;
          of_sexp_exn = erase .< t_of_sexp_exn >.;
        };
        {
          path = ["Core"; "Sexp"; "Of_sexp_error"; "t"];
          to_sexp = erase .< Of_sexp_error.sexp_of_t >.;
          of_sexp = erase .< Of_sexp_error.t_of_sexp >.;
          of_sexp_exn = erase .< Of_sexp_error.t_of_sexp_exn >.;
        };
        {
          path = ["Core"; "Sexp"; "Parse_error"; "t"];
          to_sexp = erase .< Parse_error.sexp_of_t >.;
          of_sexp = erase .< Parse_error.t_of_sexp >.;
          of_sexp_exn = erase .< Parse_error.t_of_sexp_exn >.;
        };
      ]

      let find path =
        List.find (fun (b : t) -> List.equal String.equal b.path path) all

      let conv (b : t) dir =
        match dir with
        | Dir.To_sexp -> b.to_sexp
        | Dir.Of_sexp -> b.of_sexp
        | Dir.Of_sexp_exn -> b.of_sexp_exn
    end

    (* Whether [ty] is [Sexp.t], whose conversions are the identity. *)
    let is_sexp ty =
      match ty with
      | Stag.Type_expr.Con (Stag.Path.Ref r, []) ->
        (match Stag.Type_ref.path r with
         | Stag.Type_ref.Path.Prelude path ->
           List.equal String.equal path ["Core"; "Sexp"; "t"]
         | Stag.Type_ref.Path.Program _ -> false)
      | _ -> false

    (* The converter of the declared type [r]. *)
    let named (ctx : Context.t) dir r =
      match Stag.Type_ref.path r with
      | Stag.Type_ref.Path.Prelude path ->
        (match Builtin.find path with
         | Some b -> Builtin.conv b dir
         | None ->
           fail
             (String.append "no sexp conversion of " (String.concat "." path)))
      | Stag.Type_ref.Path.Program path ->
        let modules = List.take (Int.pred (List.length path)) path in
        let name = Dir.conv_name dir (Stag.Type_ref.name r) in
        match List.equal String.equal modules ctx.self with
        | true -> var name
        | false ->
          var (String.concat "." (Cons ("", List.append modules [name])))

    (* A converter of [ty], as a function. Its arguments are [To_sexp] or
       [Of_sexp] ones. *)
    let conv ctx dir ty =
      match ty with
      | Stag.Type_expr.Var a ->
        (match dir with
         | Dir.Of_sexp_exn ->
           apply (erase .< of_sexp_exn >.) [var (param_conv a)]
         | _ -> var (param_conv a))
      | Stag.Type_expr.Con (Stag.Path.Ref r, args) ->
        let arg_dir =
          match dir with
          | Dir.To_sexp -> Dir.To_sexp
          | _ -> Dir.Of_sexp
        in
        let arg a =
          match a with
          | Stag.Type_expr.Arg.Ty ty -> conv ctx arg_dir ty
          | Stag.Type_expr.Arg.Row _ -> fail "row arguments are not supported"
        in
        apply (named ctx dir r) (List.map arg args)
      | Stag.Type_expr.Con (Stag.Path.Name path, _) ->
        fail (String.append "unresolved type " path)
      | Stag.Type_expr.Tuple _ -> inline_conv ctx dir ty
      | Stag.Type_expr.Variant _ -> inline_conv ctx dir ty
      | Stag.Type_expr.Arrow (_, _) -> fail "functions have no sexp conversion"
      | Stag.Type_expr.Code _ -> fail "code has no sexp conversion"
      | Stag.Type_expr.Record _ -> fail "polymorphic records are not supported"

    (* The conversion of [ty] matched in place, as a function. *)
    let inline_conv ctx dir ty =
      match dir with
      | Dir.To_sexp -> Stag.Expr.fun_ ["v"] (to_sexp ctx ty (var "v") "v")
      | Dir.Of_sexp ->
        apply
          (erase .< Deriving.catch >.)
          [Stag.Expr.fun_ ["sexp"] (value_of ctx ty "sexp" "v")]
      | Dir.Of_sexp_exn -> Stag.Expr.fun_ ["sexp"] (value_of ctx ty "sexp" "v")

    (* [e]'s sexp, [e] of type [ty]. Anonymous tuples and polymorphic variants
       are matched in place, binding [prefix0], [prefix1], ... *)
    let to_sexp ctx ty e prefix =
      match ty with
      | Stag.Type_expr.Tuple tys ->
        (match bind_tuple ctx tys prefix with
         | pattern, sexp -> Stag.Expr.match_ e [(pattern, sexp)])
      | Stag.Type_expr.Variant row ->
        variant_to_sexp ctx (poly_cases row) e prefix
      | _ ->
        match is_sexp ty with
        | true -> e
        | false -> apply (conv ctx Dir.To_sexp ty) [e]

    (* The pattern binding a value of type [ty] as [name], tuples destructured
       in place, and the value's sexp. *)
    let bind ctx ty name =
      let prefix = String.append name "_" in
      match ty with
      | Stag.Type_expr.Tuple tys -> bind_tuple ctx tys prefix
      | _ -> (pvar name, to_sexp ctx ty (var name) prefix)

    let bind_tuple ctx tys prefix =
      let binds =
        List.map2_exn (bind ctx) tys (vars prefix (List.length tys))
      in
      (Stag.Pattern.Tuple (List.map fst binds), sexp_list (List.map snd binds))

    (* The value of type [ty] of the sexp of variable [v], raising
       [Of_sexp_error]. *)
    let value_of ctx ty v prefix =
      match ty with
      | Stag.Type_expr.Tuple tys -> tuple_of_sexp ctx tys v prefix
      | Stag.Type_expr.Variant row ->
        variant_of_sexp ctx true (poly_cases row) v prefix
      | _ ->
        match is_sexp ty with
        | true -> var v
        | false -> apply (conv ctx Dir.Of_sexp_exn ty) [var v]

    (* The values of the variables [vs] of types [tys], each [v]'s components
       bound as [v_0], [v_1], ... *)
    let values_of ctx tys vs =
      let value ty v = value_of ctx ty v (String.append v "_") in
      List.map2_exn value tys vs

    let tuple_of_sexp (ctx : Context.t) tys v prefix =
      let n = List.length tys in
      let vs = vars prefix n in
      let error =
        apply
          (erase .< Deriving.tuple_error >.)
          [Stag.Expr.string ctx.name; Stag.Expr.int n; var v]
      in
      Stag.Expr.match_
        (var v)
        [
          (list_pattern (List.map pvar vs),
           Stag.Expr.Tuple (values_of ctx tys vs));
          (Stag.Pattern.Any, error);
        ]

    let nominal_case c =
      match c with
      | r, args ->
        {
          Case.tag = Stag.Constructor_ref.name r;
          args = args;
          construct = fun es -> Stag.Expr.Construct (Stag.Path.Ref r, es);
          pattern = fun ps -> Stag.Pattern.Construct (Stag.Path.Ref r, ps);
        }

    let poly_cases row =
      let is_unit ty =
        match ty with
        | Stag.Type_expr.Con (Stag.Path.Ref r, []) ->
          (match Stag.Type_ref.path r with
           | Stag.Type_ref.Path.Prelude ["unit"] -> true
           | _ -> false)
        | _ -> false
      in
      match row with
      | Stag.Type_expr.Row.Empty -> []
      | Stag.Type_expr.Row.Var _ ->
        fail "open polymorphic variants are not supported"
      | Stag.Type_expr.Row.Extend (tag, ty, rest) ->
        let args =
          match is_unit ty with
          | true -> []
          | false -> [ty]
        in
        let case = {
          Case.tag = tag;
          args = args;
          construct = fun es -> Stag.Expr.Poly_variant (tag, List.hd es);
          pattern = fun ps -> Stag.Pattern.Poly_variant (tag, List.hd ps);
        } in
        Cons (case, poly_cases rest)

    let variant_to_sexp ctx cases e prefix =
      let arm (case : Case.t) =
        let binds =
          List.map2_exn
            (bind ctx)
            case.args
            (vars prefix (List.length case.args))
        in
        let sexp =
          match binds with
          | [] -> atom case.tag
          | _ -> sexp_list (Cons (atom case.tag, List.map snd binds))
        in
        (case.pattern (List.map fst binds), sexp)
      in
      Stag.Expr.match_ e (List.map arm cases)

    (* Constructors are also matched uncapitalized, unless [poly], of a
       polymorphic variant's tags. *)
    let variant_of_sexp (ctx : Context.t) poly cases v prefix =
      let arm (case : Case.t) =
        match case.args with
        | [] -> (atom_pattern case.tag, case.construct [])
        | args ->
          let vs = vars prefix (List.length args) in
          (list_pattern (Cons (atom_pattern case.tag, List.map pvar vs)),
           case.construct (values_of ctx args vs))
      in
      let tags with_args =
        let tag (case : Case.t) =
          match Bool.equal (List.is_empty case.args) with_args with
          | true -> None
          | false -> Some case.tag
        in
        strings (List.filter_map tag cases)
      in
      let error =
        match poly with
        | true -> erase .< Deriving.poly_variant_error >.
        | false -> erase .< Deriving.variant_error >.
      in
      let scrutinee =
        match poly with
        | true -> var v
        | false -> apply (erase .< Deriving.capitalize >.) [var v]
      in
      let otherwise =
        (Stag.Pattern.Any,
         apply error [Stag.Expr.string ctx.name; tags false; tags true; var v])
      in
      Stag.Expr.match_ scrutinee (List.append (List.map arm cases) [otherwise])

    let record_to_sexp ctx fields =
      let field i f =
        match f with
        | r, ty ->
          let value = Stag.Expr.Field (var "v", Stag.Path.Ref r) in
          let prefix = String.concat "" ["v"; Int.to_string i; "_"] in
          apply
            (erase .< Deriving.field >.)
            [
              Stag.Expr.string (Stag.Field_ref.name r);
              to_sexp ctx ty value prefix;
            ]
      in
      sexp_list (List.mapi field fields)

    let record_of_sexp (ctx : Context.t) fields v =
      let names =
        List.map (fun f -> match f with r, _ -> Stag.Field_ref.name r) fields
      in
      (* The field names, unless one would shadow a conversion. *)
      let binders =
        let shadows name =
          List.exists
            (fun affix -> affix name)
            [
              String.starts_with "sexp_of_";
              String.starts_with "_of_";
              String.ends_with "_of_sexp";
              String.ends_with "_of_sexp_exn";
            ]
        in
        match List.exists shadows names with
        | true -> vars "v" (List.length names)
        | false -> names
      in
      let tys = List.map snd fields in
      let field f value = match f with r, _ -> (Stag.Path.Ref r, value) in
      Stag.Expr.match_
        (apply
           (erase .< Deriving.record_fields >.)
           [Stag.Expr.string ctx.name; strings names; var v])
        [
          (Stag.Pattern.list (List.map pvar binders),
           Stag.Expr.Record
             (List.map2_exn field fields (values_of ctx tys binders)));
        ]

    let derive ty =
      let r =
        match Stag.Type.expr ty with
        | Stag.Type_expr.Con (Stag.Path.Ref r, _) -> r
        | _ -> fail "a declared type is needed, as in [derive (type t)]"
      in
      let type_name = Stag.Type_ref.name r in
      let decl =
        match Stag.Type.decl r with
        | Some decl -> decl
        | None -> fail (String.append type_name " is abstract")
      in
      let self =
        match Stag.Type_ref.path r with
        | Stag.Type_ref.Path.Program path ->
          List.take (Int.pred (List.length path)) path
        | Stag.Type_ref.Path.Prelude _ ->
          fail (String.append type_name " is the prelude's")
      in
      (match String.equal type_name "sexp" with
       | true ->
         fail "a type named sexp would have two conversions named sexp_of_sexp"
       | false -> ());
      let param p =
        match p with
        | Stag.Type_decl.Param.Ty a -> param_conv a
        | Stag.Type_decl.Param.Row _ -> fail "row parameters are not supported"
      in
      let params = List.map param decl.params in
      let with_params last = List.append params [last] in
      let of_name = Dir.conv_name Dir.Of_sexp type_name in
      let exn_name = Dir.conv_name Dir.Of_sexp_exn type_name in
      let ctx = {Context.self = self; name = of_name} in
      let bodies =
        match decl.kind with
        | Stag.Type.Kind.Variant [] -> fail "empty variants are not supported"
        | Stag.Type.Kind.Variant cs ->
          let cases = List.map nominal_case cs in
          (variant_to_sexp ctx cases (var "v") "v",
           variant_of_sexp ctx false cases "sexp" "v")
        | Stag.Type.Kind.Record fields ->
          (record_to_sexp ctx fields, record_of_sexp ctx fields "sexp")
        | Stag.Type.Kind.Alias ty ->
          (to_sexp ctx ty (var "v") "v", value_of ctx ty "sexp" "v")
      in
      (* An alias of a named type converts by its conversion. *)
      let of_sexp =
        let catch =
          apply
            (erase .< Deriving.catch >.)
            [apply (var exn_name) (List.map var params); var "sexp"]
        in
        let direct ty = apply (conv ctx Dir.Of_sexp ty) [var "sexp"] in
        match decl.kind with
        | Stag.Type.Kind.Alias (Stag.Type_expr.Var a) ->
          direct (Stag.Type_expr.Var a)
        | Stag.Type.Kind.Alias (Stag.Type_expr.Con (path, args)) ->
          direct (Stag.Type_expr.Con (path, args))
        | _ -> catch
      in
      match bodies with
      | to_body, of_body ->
        [
          Stag.Toplevel.let_
            (Dir.conv_name Dir.To_sexp type_name)
            (with_params "v")
            to_body;
          Stag.Toplevel.let_ exn_name (with_params "sexp") of_body;
          Stag.Toplevel.let_ of_name (with_params "sexp") of_sexp;
        ]
  end
end

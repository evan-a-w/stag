let equal = Intrinsic.Char.equal
let compare a b = Int.compare (code a) (code b)
let code = Intrinsic.Char.code

(* [None] unless [0 <= n <= 255]. *)
let of_code n =
  match (Int.ge n 0, Int.le n 255) with
  | (true, true) -> Some (Intrinsic.Char.of_code n)
  | _ -> None

let to_string = Intrinsic.Char.to_string

let is_between low high c =
  match Int.ge (code c) (code low) with
  | true -> Int.le (code c) (code high)
  | false -> false

let is_digit c = is_between '0' '9' c
let is_lowercase c = is_between 'a' 'z' c
let is_uppercase c = is_between 'A' 'Z' c

let is_alpha c =
  match is_lowercase c with
  | true -> true
  | false -> is_uppercase c

let is_alphanum c =
  match is_alpha c with
  | true -> true
  | false -> is_digit c

(* Space, tab, newline, carriage return, form feed and vertical tab. *)
let is_whitespace c =
  match c with
  | ' ' -> true
  | '\t' -> true
  | '\n' -> true
  | '\r' -> true
  | '\012' -> true
  | '\011' -> true
  | _ -> false

(* Printable ASCII, from space to [~]. *)
let is_print c = is_between ' ' '~' c

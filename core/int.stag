let add = Prim.Int.add
let sub = Prim.Int.sub
let mul = Prim.Int.mul

(* Division by zero is a runtime error. *)
let div = Prim.Int.div
let rem = Prim.Int.rem
let neg = Prim.Int.neg
let equal = Prim.Int.equal
let compare = Prim.Int.compare
let lt = Prim.Int.lt
let le = Prim.Int.le
let gt = Prim.Int.gt
let ge = Prim.Int.ge
let succ n = add n 1
let pred n = sub n 1
let max_value = 4611686018427387903
let min_value = -4611686018427387904

let abs n =
  match lt n 0 with
  | true -> neg n
  | false -> n

let min a b =
  match le a b with
  | true -> a
  | false -> b

let max a b =
  match ge a b with
  | true -> a
  | false -> b

let to_string = Prim.Int.to_string

(* An optional [-] then decimal digits, in range; [None] otherwise. *)
let of_string s =
  let negative = String.starts_with "-" s in
  let digits =
    match negative with
    | true -> String.drop_prefix s 1
    | false -> s
  in
  let significant = String.drop_while (Char.equal '0') digits in
  let limit =
    match negative with
    | true -> String.drop_prefix (to_string min_value) 1
    | false -> to_string max_value
  in
  let in_range =
    match Int.equal (String.length significant) (String.length limit) with
    | true -> le (String.compare significant limit) 0
    | false -> lt (String.length significant) (String.length limit)
  in
  match (String.is_empty digits, String.for_all Char.is_digit digits, in_range) with
  | (false, true, true) -> Some (Prim.Int.of_string s)
  | _ -> None

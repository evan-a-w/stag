let add = Prim.Int.add
let sub = Prim.Int.sub
let mul = Prim.Int.mul

(* Division by zero is a runtime error. *)
let div = Prim.Int.div
let rem = Prim.Int.rem
let neg = Prim.Int.neg
let equal = Prim.Int.equal
let compare = Prim.Int.compare
let lt = Prim.Int.lt
let le = Prim.Int.le
let gt = Prim.Int.gt
let ge = Prim.Int.ge
let succ n = add n 1
let pred n = sub n 1
let max_value = 4611686018427387903
let min_value = -4611686018427387904

let abs n =
  match lt n 0 with
  | true -> neg n
  | false -> n

let min a b =
  match le a b with
  | true -> a
  | false -> b

let max a b =
  match ge a b with
  | true -> a
  | false -> b

let to_string = Prim.Int.to_string

(* An optional [-] then decimal digits, in range; [None] otherwise. *)
let of_string s =
  match Prim.Int.of_string_exn s with
  | n -> Some n
  | exception Failure _ -> None

(* As [of_string], raising [Failure]. *)
let of_string_exn = Prim.Int.of_string_exn
